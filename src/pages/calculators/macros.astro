---
import Layout from '../../layouts/Layout.astro';
import CTA from '../../components/CTA.astro';
import { webAppLd } from '../../lib/seo';
---
<Layout
  title="Macros Calculator: Protein, Carbs & Fat | SplitsWorkout"
  description="Free macro calculator: daily calories, protein, carbs and fat for muscle gain, fat loss or maintenance. Supports kg/lbs and cm/ft-in, with the method explained."
  canonical="/calculators/macros"
  currentPage="calculators"
  ogImage="/og/tools.png"
  breadcrumbs={[{ name: 'Calculators', url: '/calculators' }, { name: 'Macros Calculator' }]}
  jsonLd={webAppLd({ name: 'SplitsWorkout Macros Calculator', description: "Free macro calculator: get daily calories, protein, carbs and fat targets for muscle gain, fat loss or maintenance. Supports kg/lbs and cm/ft-in, with the method explained.", path: '/calculators/macros', category: 'HealthApplication' })}
>
<div class="page-header">
  <div class="page-header-inner">
    <h1 class="page-title">Macros Calculator: Protein, Carbs & Fat Targets</h1>
    <p class="page-desc">Calculate your ideal daily protein, carbohydrate, and fat targets based on your stats, goal, and activity level.</p>
  </div>
</div>
<div style="max-width:640px;margin:0 auto;padding:40px 24px 64px;">
  <div style="background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-2xl);padding:32px;">
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px;">
      <div>
        <label style="display:block;font-size:0.75rem;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:var(--text-3);margin-bottom:6px;">Age</label>
        <input type="number" id="age" value="25" class="search-input" style="height:44px;max-width:100%;" />
      </div>
      <div>
        <label style="display:block;font-size:0.75rem;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:var(--text-3);margin-bottom:6px;">Sex</label>
        <select id="sex" class="search-input" style="height:44px;max-width:100%;"><option value="male">Male</option><option value="female">Female</option></select>
      </div>
      <div>
        <label style="display:block;font-size:0.75rem;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:var(--text-3);margin-bottom:6px;">Height</label>
        <select id="hunit" class="search-input" style="height:44px;max-width:100%;margin-bottom:6px;"><option value="cm">Centimetres (cm)</option><option value="ftin">Feet &amp; inches</option></select>
        <input type="number" id="height" value="175" aria-label="Height in centimetres" class="search-input" style="height:44px;max-width:100%;" />
        <div id="ftin" style="display:none;grid-template-columns:1fr 1fr;gap:6px;">
          <input type="number" id="ft" value="5" aria-label="Feet" class="search-input" style="height:44px;max-width:100%;" />
          <input type="number" id="inch" value="9" aria-label="Inches" class="search-input" style="height:44px;max-width:100%;" />
        </div>
      </div>
      <div>
        <label style="display:block;font-size:0.75rem;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:var(--text-3);margin-bottom:6px;">Weight</label>
        <select id="wunit" class="search-input" style="height:44px;max-width:100%;margin-bottom:6px;"><option value="kg">Kilograms (kg)</option><option value="lb">Pounds (lbs)</option></select>
        <input type="number" id="weight" value="75" aria-label="Weight" class="search-input" style="height:44px;max-width:100%;" />
      </div>
    </div>
    <div style="margin-bottom:12px;">
      <label style="display:block;font-size:0.75rem;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:var(--text-3);margin-bottom:6px;">Activity Level</label>
      <select id="activity" class="search-input" style="height:44px;width:100%;"><option value="1.2">Sedentary</option><option value="1.375">Light (1–3 days/week)</option><option value="1.55" selected>Moderate (3–5 days/week)</option><option value="1.725">Active (6–7 days/week)</option><option value="1.9">Very Active</option></select>
    </div>
    <div style="margin-bottom:20px;">
      <label style="display:block;font-size:0.75rem;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:var(--text-3);margin-bottom:6px;">Goal</label>
      <div style="display:flex;gap:8px;">
        {['Build Muscle','Maintain','Lose Fat'].map(g => (
          <button class={`filter-btn${g==='Maintain'?' active':''}`} data-goal={g} style="flex:1;">{g}</button>
        ))}
      </div>
    </div>
    <button id="calc-btn" class="btn btn-primary" style="width:100%;">Calculate My Macros →</button>
    <div id="result" style="display:none;margin-top:20px;"></div>
  </div>
  <div style="margin-top:24px;background:var(--bg-2);border:1px solid var(--border);border-radius:var(--radius-xl);padding:20px;">
    <h2 style="font-size:1rem;font-weight:700;margin-bottom:10px;">Macro Recommendations</h2>
    <p style="font-size:0.8rem;color:var(--text-2);line-height:1.7;margin-bottom:8px;"><strong>Protein:</strong> 1.6–2.2g per kg of bodyweight is the general range for muscle building. Higher end if cutting calories.</p>
    <p style="font-size:0.8rem;color:var(--text-2);line-height:1.7;margin-bottom:8px;"><strong>Fat:</strong> 0.8–1.2g per kg. Essential for hormone production. Never drop below 0.6g/kg.</p>
    <p style="font-size:0.8rem;color:var(--text-2);line-height:1.7;"><strong>Carbohydrates:</strong> Fill the remaining calories. Fuel for training and performance.</p>
  </div>
</div>

<div class="seo-page" style="padding-top:0;">
  <h2>How this macro calculator works</h2>
  <p>The calculator first estimates your maintenance calories (TDEE) with the Mifflin-St Jeor equation and your activity multiplier. It then adjusts that figure for your goal and divides the calories into protein, fat and carbohydrates.</p>
  <div class="seo-scroll"><table class="seo-table"><thead><tr><th>Step</th><th>What we use</th></tr></thead><tbody>
    <tr><td>Calories</td><td>TDEE × 1.12 to build muscle, × 1.00 to maintain, × 0.82 to lose fat</td></tr>
    <tr><td>Protein</td><td>2.0 g per kg of bodyweight (2.2 g/kg when losing fat)</td></tr>
    <tr><td>Fat</td><td>1.0 g per kg of bodyweight</td></tr>
    <tr><td>Carbohydrates</td><td>Remaining calories ÷ 4 (shown with a 50 g minimum)</td></tr>
  </tbody></table></div>
  <h2>Macros for muscle gain and for weight loss</h2>
  <p><strong>Muscle gain:</strong> a modest surplus (about 10–15%) supports training and recovery without adding more fat than necessary. <strong>Weight loss:</strong> a deficit of roughly 15–20% with higher protein helps preserve muscle. These are starting points — track your weight for two to three weeks and adjust by 100–150 calories if it is not moving the way you want.</p>
  <h2>Limitations</h2>
  <ul>
    <li>All equations are estimates; real energy needs vary by 10–15% or more between people.</li>
    <li>The 50 g carbohydrate minimum can push the totals slightly above your calorie target at very low calories.</li>
    <li>The calculator is not a substitute for advice from a doctor or registered dietitian, particularly if you have a medical condition or are pregnant.</li>
  </ul>
  <p>Want to see how this fits into a training plan? Read about the <a href="/workout-splits/best-workout-split">best workout split for your goal</a>. Calculate your baseline separately with the <a href="/calculators/tdee">TDEE calculator</a> or check the <a href="/calculators/bmi">BMI calculator</a>. See <a href="/methodology/calculators">how our calculators are built</a>.</p>
  <CTA variant="calculator" />
</div>
<script>
let selectedGoal = 'Maintain';
document.querySelectorAll('[data-goal]').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('[data-goal]').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    selectedGoal = btn.getAttribute('data-goal') || 'Maintain';
  });
});
document.getElementById('hunit')?.addEventListener('change', (e) => {
  const ft = (e.target as HTMLSelectElement).value === 'ftin';
  (document.getElementById('height') as HTMLElement).style.display = ft ? 'none' : '';
  (document.getElementById('ftin') as HTMLElement).style.display = ft ? 'grid' : 'none';
});
document.getElementById('calc-btn')?.addEventListener('click', () => {
  const age = parseFloat((document.getElementById('age') as HTMLInputElement).value);
  const sex = (document.getElementById('sex') as HTMLSelectElement).value;
  const useFtIn = (document.getElementById('hunit') as HTMLSelectElement).value === 'ftin';
  const h = useFtIn
    ? (parseFloat((document.getElementById('ft') as HTMLInputElement).value || '0') * 12 + parseFloat((document.getElementById('inch') as HTMLInputElement).value || '0')) * 2.54
    : parseFloat((document.getElementById('height') as HTMLInputElement).value);
  const wRaw = parseFloat((document.getElementById('weight') as HTMLInputElement).value);
  const w = (document.getElementById('wunit') as HTMLSelectElement).value === 'lb' ? wRaw / 2.2046 : wRaw;
  const act = parseFloat((document.getElementById('activity') as HTMLSelectElement).value);
  if (!age||!h||!w) return;
  const bmr = sex==='male' ? 10*w+6.25*h-5*age+5 : 10*w+6.25*h-5*age-161;
  let tdee = Math.round(bmr*act);
  const goalMods = {'Build Muscle':1.12,'Maintain':1,'Lose Fat':0.82};
  const calories = Math.round(tdee*(goalMods[selectedGoal]||1));
  const protein = Math.round(w * (selectedGoal==='Lose Fat' ? 2.2 : 2.0));
  const fat = Math.round(w * 1.0);
  const carbs = Math.round((calories - protein*4 - fat*9) / 4);
  const r = document.getElementById('result');
  if (!r) return;
  r.style.display = 'block';
  r.innerHTML = `
    <div style="text-align:center;background:var(--accent-bg);border:1px solid var(--accent-border);border-radius:var(--radius-xl);padding:16px;margin-bottom:16px;">
      <div style="font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:var(--accent-hover);margin-bottom:4px;">Daily Target (${selectedGoal})</div>
      <div style="font-family:'Poppins',sans-serif;font-size:2.5rem;font-weight:900;color:var(--accent);">${calories.toLocaleString()} <span style="font-size:1rem;">cal</span></div>
    </div>
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px;">
      <div style="background:#EFF6FF;border:1px solid #BFDBFE;border-radius:var(--radius-lg);padding:16px;text-align:center;">
        <div style="font-size:0.65rem;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#1D4ED8;margin-bottom:4px;">Protein</div>
        <div style="font-family:'Poppins',sans-serif;font-size:1.5rem;font-weight:800;color:#1D4ED8;">${protein}g</div>
        <div style="font-size:0.7rem;color:#60A5FA;">${protein*4} kcal</div>
      </div>
      <div style="background:#F0FDF4;border:1px solid #BBF7D0;border-radius:var(--radius-lg);padding:16px;text-align:center;">
        <div style="font-size:0.65rem;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#15803D;margin-bottom:4px;">Carbs</div>
        <div style="font-family:'Poppins',sans-serif;font-size:1.5rem;font-weight:800;color:#15803D;">${Math.max(carbs,50)}g</div>
        <div style="font-size:0.7rem;color:#4ADE80;">${Math.max(carbs,50)*4} kcal</div>
      </div>
      <div style="background:#FFF7ED;border:1px solid #FDBA74;border-radius:var(--radius-lg);padding:16px;text-align:center;">
        <div style="font-size:0.65rem;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#C2410C;margin-bottom:4px;">Fat</div>
        <div style="font-family:'Poppins',sans-serif;font-size:1.5rem;font-weight:800;color:#C2410C;">${fat}g</div>
        <div style="font-size:0.7rem;color:#FB923C;">${fat*9} kcal</div>
      </div>
    </div>
    <p style="font-size:0.72rem;color:var(--text-4);text-align:center;margin-top:10px;">These are starting estimates. Adjust based on your actual progress and hunger.</p>
  `;
});
</script>
</Layout>
