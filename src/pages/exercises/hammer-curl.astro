---
import Layout from '../../layouts/Layout.astro';
import MuscleSVG from '../../components/MuscleSVG.astro';
import { getExercise, exercises } from '../../data/exercises';

const ex = getExercise('hammer-curl')!;
const related = exercises
  .filter(e => e.slug !== 'hammer-curl' && (e.primaryMuscle === ex.primaryMuscle || ex.alternatives.includes(e.slug)))
  .slice(0, 4);

const schemaData = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": ex.name + " — How To & Form Guide",
  "description": ex.description.slice(0, 155),
  "author": { "@type": "Organization", "name": "SplitsWorkout" }
};
const schema = JSON.stringify(schemaData);

const diffColors = { Beginner: '#22C55E', Intermediate: '#F59E0B', Advanced: '#EF4444' };
const muscleColors = {
  'Chest':'#EF4444','Back':'#3B82F6','Lats':'#3B82F6','Shoulders':'#F59E0B',
  'Quads':'#10B981','Hamstrings':'#06B6D4','Glutes':'#EC4899','Biceps':'#8B5CF6',
  'Triceps':'#A78BFA','Core':'#6B7280','Calves':'#84CC16',
};
const primaryColor = muscleColors[ex.primaryMuscle as keyof typeof muscleColors] || '#22C55E';
const icons = {
  'Chest':'🏋️','Back':'💪','Lats':'💪','Shoulders':'🦾','Quads':'🦵',
  'Hamstrings':'🦵','Glutes':'🍑','Biceps':'💪','Triceps':'💪','Core':'🔥','Calves':'🦵',
};
const icon = icons[ex.primaryMuscle as keyof typeof icons] || '🏋️';
---

<Layout
  title={ex.name + " — How To, Muscles & Form Guide | SplitsWorkout"}
  description={ex.description.slice(0, 155)}
  canonical={"/exercises/" + ex.slug}
  currentPage="exercises"
  schema={schema}
>

<div class="page-header">
  <div class="page-header-inner">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a><span class="breadcrumb-sep">›</span>
      <a href="/exercises">Exercises</a><span class="breadcrumb-sep">›</span>
      <span>{ex.name}</span>
    </nav>
    <h1 class="page-title">{ex.name}</h1>
    <p class="page-desc">{ex.description}</p>
    <div class="page-meta">
      <span class={`tag diff-${ex.difficulty.toLowerCase()}`}>{ex.difficulty}</span>
      <span class="tag tag-green">💪 {ex.primaryMuscle}</span>
      <span class="tag tag-gray">{ex.type}</span>
      <span class="tag tag-purple">{ex.movement}</span>
    </div>
  </div>
</div>

<div class="content-wrap">
  <article class="content-article">
    <div class="prose">

      <!-- Sets/Reps quick view -->
      <div class="sets-row">
        <div class="sets-card"><div class="sets-card-label">Sets</div><div class="sets-card-value">{ex.sets}</div></div>
        <div class="sets-card"><div class="sets-card-label">Reps</div><div class="sets-card-value">{ex.reps}</div></div>
        <div class="sets-card"><div class="sets-card-label">Rest</div><div class="sets-card-value" style="font-size:1rem;">{ex.rest}</div></div>
        <div class="sets-card"><div class="sets-card-label">Type</div><div class="sets-card-value" style="font-size:0.9rem;color:var(--text);">{ex.type}</div></div>
      </div>

      <!-- Visual & muscles -->
      <div style="display:grid;grid-template-columns:1fr auto;gap:24px;align-items:start;margin:24px 0;background:var(--bg-2);border:1px solid var(--border);border-radius:var(--radius-xl);padding:24px;">
        <div>
          <h2 style="margin-top:0;border-bottom:none;padding-bottom:0;font-size:1.25rem;">Muscles Worked</h2>
          <div style="margin:12px 0;">
            <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px;">
              <div style={`width:12px;height:12px;border-radius:50%;background:${primaryColor};flex-shrink:0;`}></div>
              <div>
                <div style="font-size:0.7rem;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:var(--text-3);">Primary</div>
                <a href={"/muscles/"+ex.primaryMuscle.toLowerCase().replace(/ /g,'-')} style="font-weight:600;color:var(--text);">{ex.primaryMuscle}</a>
              </div>
            </div>
            {ex.secondaryMuscles.map(m => (
              <div style="display:flex;align-items:center;gap:10px;margin-bottom:8px;">
                <div style="width:8px;height:8px;border-radius:50%;background:var(--text-4);flex-shrink:0;"></div>
                <div>
                  <div style="font-size:0.7rem;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:var(--text-4);">Secondary</div>
                  <span style="font-size:0.875rem;color:var(--text-2);">{m}</span>
                </div>
              </div>
            ))}
          </div>
          <div style="display:flex;gap:6px;flex-wrap:wrap;margin-top:12px;">
            {ex.equipment.map(e => <span class="tag tag-gray">{e}</span>)}
          </div>
        </div>
        <MuscleSVG
          primary={ex.muscleMap.primary}
          secondary={ex.muscleMap.secondary}
          size="md"
          view="both"
        />
      </div>

      <h2>How to Perform</h2>
      <ol style="padding-left:20px;">
        {ex.instructions.map(step => <li style="margin-bottom:10px;color:var(--text-2);line-height:1.7;">{step}</li>)}
      </ol>

      <h2>Key Form Cues</h2>
      <ul style="list-style:none;padding:0;">
        {ex.formCues.map(cue => (
          <li style="display:flex;gap:10px;margin-bottom:10px;padding:12px;background:var(--accent-bg);border:1px solid var(--accent-border);border-radius:var(--radius);font-size:0.875rem;color:var(--text-2);">
            <span style="color:var(--accent);font-weight:700;flex-shrink:0;">✓</span>
            <span>{cue}</span>
          </li>
        ))}
      </ul>

      <h2>Common Mistakes</h2>
      <ul style="list-style:none;padding:0;">
        {ex.commonMistakes.map(m => (
          <li style="display:flex;gap:10px;margin-bottom:10px;padding:12px;background:#FEF2F2;border:1px solid #FECACA;border-radius:var(--radius);font-size:0.875rem;color:var(--text-2);">
            <span style="color:#EF4444;font-weight:700;flex-shrink:0;">✗</span>
            <span>{m}</span>
          </li>
        ))}
      </ul>

      {ex.alternatives.length > 0 && (
        <div>
          <h2>Exercise Alternatives</h2>
          <p>Can't do the {ex.name}? Try these alternatives that target the same muscles:</p>
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:8px;margin:12px 0;">
            {ex.alternatives.map(alt => (
              <a href={"/exercises/"+alt} style="background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:12px;text-decoration:none;display:flex;align-items:center;justify-content:space-between;font-size:0.85rem;font-weight:600;color:var(--text);transition:all 0.15s;" onmouseover="this.style.borderColor='var(--accent)'" onmouseout="this.style.borderColor='var(--border)'">
                {alt.replace(/-/g,' ').replace(/\b\w/g, c => c.toUpperCase())}
                <span style="color:var(--accent);">→</span>
              </a>
            ))}
          </div>
        </div>
      )}

      <h2>Where It Fits</h2>
      <div style="display:flex;gap:8px;flex-wrap:wrap;">
        {ex.relatedSplits.map(s => (
          <a href={"/"+s} class="btn btn-secondary btn-sm">{s.replace(/-/g,' ').replace(/\b\w/g, c => c.toUpperCase())}</a>
        ))}
      </div>

      <h2>FAQ</h2>
      {[
        [`How many sets of ${ex.name} should I do?`, `${ex.sets} sets of ${ex.reps} reps is a solid standard. Adjust based on your training frequency and how it fits within your weekly programme.`],
        [`What muscles does the ${ex.name} work?`, `The ${ex.name} primarily works the ${ex.primaryMuscle}. Secondary muscles include ${ex.secondaryMuscles.join(', ')}.`],
        [`Is the ${ex.name} good for beginners?`, `The ${ex.name} is rated ${ex.difficulty}. ${ex.difficulty === 'Beginner' ? 'It is suitable for beginners with proper instruction and light loads.' : ex.difficulty === 'Intermediate' ? 'Beginners should build a foundation with simpler movements before adding this exercise.' : 'This exercise demands solid technique — build your base before attempting it.'}`],
      ].map(([q,a]) => (
        <div class="faq-item">
          <div class="faq-q"><span>{q}</span><span class="faq-icon">▾</span></div>
          <div class="faq-a">{a}</div>
        </div>
      ))}

    </div>
  </article>

  <aside class="content-sidebar">
    <div class="sidebar-card">
      <div class="sidebar-card-title">Quick Stats</div>
      <div class="sidebar-stat"><span>Primary Muscle</span><strong>{ex.primaryMuscle}</strong></div>
      <div class="sidebar-stat"><span>Type</span><strong>{ex.type}</strong></div>
      <div class="sidebar-stat"><span>Movement</span><strong>{ex.movement}</strong></div>
      <div class="sidebar-stat"><span>Difficulty</span><strong>{ex.difficulty}</strong></div>
      <div class="sidebar-stat"><span>Sets</span><strong>{ex.sets}</strong></div>
      <div class="sidebar-stat"><span>Reps</span><strong>{ex.reps}</strong></div>
      <div class="sidebar-stat"><span>Rest</span><strong>{ex.rest}</strong></div>
    </div>

    {related.length > 0 && (
      <div class="sidebar-card">
        <div class="sidebar-card-title">Related Exercises</div>
        {related.map(r => (
          <a href={"/exercises/"+r.slug} class="sidebar-link">
            <span>{r.name}</span>
            <span style="font-size:0.72rem;color:var(--text-3);">{r.primaryMuscle}</span>
          </a>
        ))}
      </div>
    )}

    <div class="sidebar-card">
      <div class="sidebar-card-title">Tags</div>
      <div style="display:flex;gap:6px;flex-wrap:wrap;">
        {ex.tags.map(t => <span class="tag tag-gray" style="font-size:0.7rem;">{t}</span>)}
      </div>
    </div>

    <a href="/exercises" class="btn btn-secondary" style="width:100%;justify-content:center;">← All Exercises</a>
  </aside>
</div>

</Layout>
