  /* Coverage */
  .wb-cov-row { display:grid;grid-template-columns:90px 1fr 54px;align-items:center;gap:8px;margin-bottom:8px; }
  .wb-cov-label { font-size:0.78rem;font-weight:600;color:var(--text-2); }
