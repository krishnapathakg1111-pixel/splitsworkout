---
import Layout from '../layouts/Layout.astro';
import { exercises } from '../data/exercises';

const exData = exercises.map(e => ({
  slug: e.slug,
  name: e.name,
  category: e.category,
  muscle: e.primaryMuscle,
  sets: e.sets,
  reps: e.reps,
  difficulty: e.difficulty,
}));
---

<Layout
  title="Workout Builder — Create Your Custom Plan | SplitsWorkout"
  description="Build a custom workout plan for free. Add exercises, create your weekly schedule, analyze muscle coverage, and export a PDF. No account required."
  canonical="/workout-builder"
  currentPage="builder"
>

<div class="page-header">
  <div class="page-header-inner">
    <nav class="breadcrumb"><a href="/">Home</a><span class="breadcrumb-sep">›</span><span>Workout Builder</span></nav>
    <h1 class="page-title">Workout Builder</h1>
    <p class="page-desc">Build your custom weekly training plan. Add exercises to each day, customise sets &amp; reps, track muscle coverage, and export a printable PDF.</p>
    <div class="page-meta">
      <span class="tag tag-green">✓ Free forever</span>
      <span class="tag tag-purple">📄 PDF export</span>
      <span class="tag tag-gray">💾 Saves locally</span>
    </div>
  </div>
</div>

<div id="wb-root">
  <div id="wb-left">
    <!-- TOP BAR -->
    <div class="wb-card" style="margin-bottom:14px;">
      <div class="wb-card-hd">
        <span class="wb-card-title">📋 My Workout</span>
        <div style="display:flex;gap:8px;">
          <button id="wb-save" class="btn btn-secondary btn-sm">💾 Save</button>
          <button id="wb-load" class="btn btn-ghost btn-sm">📂 Load</button>
          <button id="wb-pdf" class="btn btn-primary btn-sm">📄 Export PDF</button>
        </div>
      </div>
      <div style="padding:12px 20px;">
        <input id="wb-planname" type="text" value="My Workout Plan" placeholder="Workout name..."
          style="width:100%;background:transparent;border:none;outline:none;font-family:'Poppins',sans-serif;font-size:1.1rem;font-weight:700;color:var(--text);" />
      </div>
    </div>

    <!-- ACTIVE DAY INDICATOR -->
    <div id="wb-active-label" style="font-size:0.78rem;font-weight:700;color:var(--accent);margin-bottom:10px;padding:0 2px;"></div>

    <!-- DAYS -->
    <div id="wb-days"></div>

    <!-- ADD DAY -->
    <button id="wb-addday" class="wb-addbtn">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      Add Training Day
    </button>

    <!-- COVERAGE -->
    <div class="wb-card" style="margin-top:18px;">
      <div class="wb-card-hd">
        <span class="wb-card-title">💪 Weekly Muscle Coverage</span>
        <span style="font-size:0.72rem;color:var(--text-3);">8–20 sets/week per muscle is optimal</span>
      </div>
      <div id="wb-coverage" style="padding:16px 20px;">
        <div class="wb-empty"><div style="font-size:2rem;margin-bottom:6px;">📊</div>Add exercises to see coverage</div>
      </div>
    </div>
  </div>

  <!-- RIGHT: PICKER -->
  <div id="wb-right">
    <div class="wb-card" style="position:sticky;top:88px;">
      <div class="wb-card-hd">
        <span class="wb-card-title">🏋️ Exercise Library</span>
        <span id="wb-excount" style="font-size:0.7rem;color:var(--text-3);font-weight:500;"></span>
      </div>

      <div id="wb-picker-controls">
        <!-- Search -->
        <div style="position:relative;margin-bottom:10px;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            style="position:absolute;left:11px;top:50%;transform:translateY(-50%);color:var(--text-4);pointer-events:none;">
            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
          </svg>
          <input id="wb-search" type="search" placeholder="Search 126 exercises..." autocomplete="off"
            style="width:100%;height:40px;padding:0 12px 0 34px;border:1.5px solid var(--border);border-radius:var(--radius-lg);
                   background:var(--bg-2);color:var(--text);font-size:0.82rem;outline:none;box-sizing:border-box;" />
        </div>
        <!-- Category chips -->
        <div id="wb-chips" style="display:flex;flex-wrap:wrap;gap:5px;"></div>
      </div>

      <div id="wb-picker-list" role="list"></div>

      <div style="padding:9px 14px;text-align:center;font-size:0.7rem;color:var(--text-3);border-top:1px solid var(--border);">
        Tap <strong>+</strong> to add to the active day
      </div>
    </div>
  </div>
</div>

<!-- Toasts -->
<div id="wb-toasts"></div>

<style is:global>
  /* ── WORKOUT BUILDER — all styles must be global for JS-created elements ── */
  #wb-root {
    max-width: 1300px;
    margin: 0 auto;
    padding: 20px 24px 60px;
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 20px;
    align-items: start;
  }
  @media(max-width:1024px) {
    #wb-root { grid-template-columns: 1fr !important; }
    #wb-right { position: static !important; }
  }

  /* Cards */
  .wb-card { background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-xl);overflow:hidden; }
  .wb-card-hd {
    display:flex;align-items:center;justify-content:space-between;
    padding:12px 20px;border-bottom:1px solid var(--border);background:var(--bg-2);
  }
  .wb-card-title { font-family:'Poppins',sans-serif;font-weight:700;font-size:0.875rem;color:var(--text); }

  /* Add day button */
  .wb-addbtn {
    width:100%;margin-top:10px;padding:14px;border:1.5px dashed var(--border);
    border-radius:var(--radius-xl);background:transparent;color:var(--text-3);
    font-size:0.82rem;font-weight:600;cursor:pointer;
    display:flex;align-items:center;justify-content:center;gap:8px;transition:all 0.15s;
  }
  .wb-addbtn:hover { border-color:var(--accent);color:var(--accent);background:var(--accent-bg); }

  /* Empty states */
  .wb-empty { text-align:center;padding:24px;color:var(--text-3);font-size:0.82rem;line-height:1.6; }

  /* ── DAY BLOCKS ── */
  .wb-day {
    background:var(--surface);border:1.5px solid var(--border);
    border-radius:var(--radius-xl);margin-bottom:12px;overflow:hidden;
    transition:border-color 0.15s,box-shadow 0.15s;
  }
  .wb-day.active {
    border-color:var(--accent);
    box-shadow:0 0 0 3px rgba(34,197,94,0.12);
  }
  .wb-day-hd {
    display:flex;align-items:center;gap:10px;padding:11px 16px;
    background:var(--bg-2);border-bottom:1px solid var(--border);
    cursor:pointer;transition:background 0.15s;
  }
  .wb-day.active .wb-day-hd { background:rgba(34,197,94,0.08); }
  .wb-day-dot {
    width:10px;height:10px;border-radius:50%;background:var(--border-strong);
    flex-shrink:0;transition:background 0.15s;
  }
  .wb-day.active .wb-day-dot { background:var(--accent); }
  .wb-day-name {
    flex:1;min-width:0;background:transparent;border:none;outline:none;
    font-family:'Poppins',sans-serif;font-weight:700;font-size:0.875rem;
    color:var(--text);cursor:pointer;
  }
  .wb-day-name:focus { cursor:text; }
  .wb-day-btns { display:flex;gap:4px;margin-left:auto;flex-shrink:0; }
  .wb-ico-btn {
    border:1px solid var(--border);background:transparent;border-radius:var(--radius);
    width:28px;height:28px;display:flex;align-items:center;justify-content:center;
    cursor:pointer;font-size:0.75rem;color:var(--text-3);transition:all 0.15s;
  }
  .wb-ico-btn.sel:hover { border-color:var(--accent);color:var(--accent);background:var(--accent-bg); }
  .wb-ico-btn.del:hover { border-color:#EF4444;color:#EF4444;background:rgba(239,68,68,0.08); }

  /* Exercise rows inside days */
  .wb-day-body { padding:10px 12px 12px; }
  .wb-ex-row {
    display:flex;align-items:center;gap:8px;padding:9px 10px;
    border:1px solid var(--border);border-radius:var(--radius);
    margin-bottom:6px;background:var(--bg-2);font-size:0.82rem;
  }
  .wb-ex-dot { width:8px;height:8px;border-radius:50%;flex-shrink:0; }
  .wb-ex-name {
    flex:1;min-width:0;font-weight:600;color:var(--text);
    overflow:hidden;text-overflow:ellipsis;white-space:nowrap;
  }
  .wb-lbl { font-size:0.62rem;color:var(--text-4);white-space:nowrap; }
  .wb-setsreps {
    width:44px;height:28px;border:1px solid var(--border);border-radius:var(--radius);
    background:var(--surface);color:var(--text);text-align:center;
    font-size:0.78rem;font-weight:600;outline:none;padding:0 4px;
  }
  .wb-setsreps:focus { border-color:var(--accent); }
  .wb-ex-del {
    background:transparent;border:none;color:var(--text-4);cursor:pointer;
    padding:2px 6px;border-radius:4px;font-size:0.85rem;transition:color 0.12s;
  }
  .wb-ex-del:hover { color:#EF4444; }
  .wb-day-empty { padding:14px 0;text-align:center;font-size:0.78rem;color:var(--text-4); }

  /* ── EXERCISE PICKER ── */
  #wb-picker-controls { padding:12px 14px;border-bottom:1px solid var(--border); }

  /* Category filter chips */
  .wb-chip {
    border:1.5px solid var(--border);background:transparent;border-radius:100px;
    padding:4px 12px;font-size:0.72rem;font-weight:600;color:var(--text-3);
    cursor:pointer;transition:all 0.12s;white-space:nowrap;
  }
  .wb-chip:hover { border-color:var(--accent);color:var(--accent); }
  .wb-chip.on { background:var(--accent);border-color:var(--accent);color:white; }

  /* Exercise list */
  #wb-picker-list { max-height:460px;overflow-y:auto; }
  .wb-pi {
    display:flex;align-items:center;gap:10px;padding:11px 14px;
    border-bottom:1px solid var(--border);cursor:pointer;
    transition:background 0.1s;user-select:none;
  }
  .wb-pi:last-child { border-bottom:none; }
  .wb-pi:hover { background:var(--bg-2); }
  .wb-pi-badge {
    width:40px;height:40px;border-radius:var(--radius);display:flex;
    align-items:center;justify-content:center;flex-shrink:0;
    font-weight:800;font-size:0.62rem;letter-spacing:0.02em;
  }
  .wb-pi-info { flex:1;min-width:0; }
  .wb-pi-name {
    font-weight:700;font-size:0.875rem;color:var(--text);
    overflow:hidden;text-overflow:ellipsis;white-space:nowrap;
  }
  .wb-pi-sub { font-size:0.7rem;color:var(--text-3);margin-top:2px; }

  /* The + add button */
  .wb-plus {
    width:36px;height:36px;border-radius:var(--radius);
    background:var(--accent);border:none;color:white;
    font-size:1.4rem;font-weight:700;cursor:pointer;
    display:flex;align-items:center;justify-content:center;
    flex-shrink:0;transition:all 0.12s;line-height:1;
  }
  .wb-plus:hover { background:#16A34A;transform:scale(1.1); }
  .wb-plus:active { transform:scale(0.93); }

  /* ── COVERAGE BARS ── */
  .wb-cov-row {
    display:grid;grid-template-columns:96px 1fr 54px;
    align-items:center;gap:8px;margin-bottom:9px;
  }
  .wb-cov-label { font-size:0.78rem;font-weight:600;color:var(--text-2); }
  .wb-cov-track { height:8px;border-radius:100px;background:var(--bg-3);overflow:hidden; }
  .wb-cov-fill { height:100%;border-radius:100px;transition:width 0.4s ease; }
  .wb-cov-sets { font-size:0.7rem;font-weight:700;text-align:right; }

  /* ── TOASTS ── */
  #wb-toasts {
    position:fixed;bottom:24px;right:24px;z-index:9999;
    display:flex;flex-direction:column;gap:7px;pointer-events:none;
  }
  .wb-toast {
    background:#1F2937;color:white;padding:10px 16px;border-radius:var(--radius-lg);
    font-size:0.82rem;font-weight:500;box-shadow:0 4px 20px rgba(0,0,0,0.25);
    pointer-events:auto;border-left:3px solid #22C55E;max-width:280px;
    animation:wbIn 0.18s ease;
  }
  .wb-toast.err { border-left-color:#EF4444; }
  .wb-toast.bye { animation:wbOut 0.22s ease forwards; }
  @keyframes wbIn { from{opacity:0;transform:translateY(6px)} to{opacity:1;transform:translateY(0)} }
  @keyframes wbOut { to{opacity:0;transform:translateY(6px)} }

  /* ── SEARCH INPUT ── */
  #wb-search {
    width:100%;height:40px;padding:0 12px 0 34px;
    border:1.5px solid var(--border);border-radius:var(--radius-lg);
    background:var(--bg-2);color:var(--text);font-size:0.82rem;outline:none;
    box-sizing:border-box;transition:border-color 0.15s;
  }
  #wb-search:focus { border-color:var(--accent); }
  #wb-search::placeholder { color:var(--text-4); }

  .wb-card { background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-xl);overflow:hidden; }
  .wb-card-hd { display:flex;align-items:center;justify-content:space-between;padding:12px 20px;border-bottom:1px solid var(--border);background:var(--bg-2); }
  .wb-card-title { font-family:'Poppins',sans-serif;font-weight:700;font-size:0.875rem;color:var(--text); }

  .wb-addbtn {
    width:100%;margin-top:10px;padding:14px;border:1.5px dashed var(--border);border-radius:var(--radius-xl);
    background:transparent;color:var(--text-3);font-size:0.82rem;font-weight:600;cursor:pointer;
    display:flex;align-items:center;justify-content:center;gap:8px;transition:all 0.15s;
  }
  .wb-addbtn:hover { border-color:var(--accent);color:var(--accent);background:var(--accent-bg); }

  .wb-empty { text-align:center;padding:24px;color:var(--text-3);font-size:0.82rem; }

  /* Day block */
  .wb-day { background:var(--surface);border:1.5px solid var(--border);border-radius:var(--radius-xl);margin-bottom:12px;overflow:hidden;transition:border-color 0.15s,box-shadow 0.15s; }
  .wb-day.active { border-color:var(--accent);box-shadow:0 0 0 3px rgba(34,197,94,0.1); }
  .wb-day-hd {
    display:flex;align-items:center;gap:10px;padding:11px 16px;
    background:var(--bg-2);border-bottom:1px solid var(--border);cursor:pointer;
    transition:background 0.15s;
  }
  .wb-day.active .wb-day-hd { background:rgba(34,197,94,0.08); }
  .wb-day-dot { width:9px;height:9px;border-radius:50%;background:var(--border-strong);flex-shrink:0;transition:background 0.15s; }
  .wb-day.active .wb-day-dot { background:var(--accent); }
  .wb-day-name {
    flex:1;min-width:0;background:transparent;border:none;outline:none;
    font-family:'Poppins',sans-serif;font-weight:700;font-size:0.875rem;color:var(--text);cursor:pointer;
  }
  .wb-day-name:focus { cursor:text; }
  .wb-day-btns { display:flex;gap:4px;margin-left:auto;flex-shrink:0; }
  .wb-ico-btn {
    border:1px solid var(--border);background:transparent;border-radius:var(--radius);
    width:28px;height:28px;display:flex;align-items:center;justify-content:center;
    cursor:pointer;font-size:0.75rem;color:var(--text-3);transition:all 0.15s;
  }
  .wb-ico-btn.sel:hover { border-color:var(--accent);color:var(--accent);background:var(--accent-bg); }
  .wb-ico-btn.del:hover { border-color:#EF4444;color:#EF4444;background:rgba(239,68,68,0.08); }

  /* Exercise rows in days */
  .wb-day-body { padding:10px 12px 12px; }
  .wb-ex-row {
    display:flex;align-items:center;gap:8px;padding:9px 10px;
    border:1px solid var(--border);border-radius:var(--radius);margin-bottom:6px;
    background:var(--bg-2);font-size:0.82rem;
  }
  .wb-ex-dot { width:8px;height:8px;border-radius:50%;flex-shrink:0; }
  .wb-ex-name { flex:1;min-width:0;font-weight:600;color:var(--text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap; }
  .wb-lbl { font-size:0.62rem;color:var(--text-4);white-space:nowrap; }
  .wb-setsreps {
    width:44px;height:28px;border:1px solid var(--border);border-radius:var(--radius);
    background:var(--surface);color:var(--text);text-align:center;font-size:0.78rem;font-weight:600;
    outline:none;padding:0 4px;
  }
  .wb-setsreps:focus { border-color:var(--accent); }
  .wb-ex-del { background:transparent;border:none;color:var(--text-4);cursor:pointer;padding:2px 6px;border-radius:4px;font-size:0.85rem;transition:color 0.12s; }
  .wb-ex-del:hover { color:#EF4444; }
  .wb-day-empty { padding:12px 0;text-align:center;font-size:0.78rem;color:var(--text-4); }

  /* Picker */
  #wb-picker-controls { padding:12px 14px;border-bottom:1px solid var(--border); }
  .wb-chip {
    border:1.5px solid var(--border);background:transparent;border-radius:100px;
    padding:4px 12px;font-size:0.72rem;font-weight:600;color:var(--text-3);cursor:pointer;transition:all 0.12s;
  }
  .wb-chip:hover { border-color:var(--accent);color:var(--accent); }
  .wb-chip.on { background:var(--accent);border-color:var(--accent);color:white; }

