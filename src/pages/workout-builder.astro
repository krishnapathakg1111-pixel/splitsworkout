</style>

<script define:vars={{ exData }}>
// ───────────────────────────────────
// WORKOUT BUILDER — Full rewrite
// All DOM work runs after DOMContentLoaded
// ───────────────────────────────────

const EXERCISES = exData;

const MC = {
  'Chest':'#EF4444','Upper Chest':'#F87171','Back':'#3B82F6','Lats':'#60A5FA',
  'Upper Back':'#93C5FD','Traps':'#BFDBFE','Shoulders':'#F59E0B','Side Delts':'#FCD34D',
  'Rear Delts':'#FDE68A','Quads':'#10B981','Hamstrings':'#06B6D4','Glutes':'#EC4899',
  'Calves':'#84CC16','Soleus':'#A3E635','Biceps':'#8B5CF6','Brachialis':'#A78BFA',
  'Brachioradialis':'#C4B5FD','Triceps':'#7C3AED','Forearms':'#6D28D9',
  'Core':'#6B7280','Obliques':'#9CA3AF','Full Body':'#22C55E',
};

const CATS = ['All','Chest','Back','Shoulders','Biceps','Triceps','Quads','Hamstrings','Glutes','Calves','Core','Full Body','Forearms'];

// ── STATE ──
let days = [
  { name: 'Day 1 — Push', exercises: [] },
  { name: 'Day 2 — Pull', exercises: [] },
  { name: 'Day 3 — Legs', exercises: [] },
];
let activeDay = 0;
let filterCat = 'All';
let searchQ = '';

// ── TOAST ──
function toast(msg, type) {
  const c = document.getElementById('wb-toasts');
  if (!c) return;
  const el = document.createElement('div');
  el.className = 'wb-toast' + (type === 'err' ? ' err' : '');
  el.textContent = msg;
  c.appendChild(el);
  setTimeout(function() {
    el.classList.add('bye');
    setTimeout(function() { if (el.parentNode) el.parentNode.removeChild(el); }, 240);
  }, 2500);
}

// ── RENDER DAYS (left column) ──
function renderDays() {
  const container = document.getElementById('wb-days');
  if (!container) return;
  container.innerHTML = '';

  const label = document.getElementById('wb-active-label');
  if (label) {
    const d = days[activeDay];
    label.textContent = d ? '● Adding exercises to: ' + d.name : '';
  }

  days.forEach(function(day, di) {
    const isAct = di === activeDay;
    const block = document.createElement('div');
    block.className = 'wb-day' + (isAct ? ' active' : '');

    // ── Header ──
    const hd = document.createElement('div');
    hd.className = 'wb-day-hd';

    const dot = document.createElement('div');
    dot.className = 'wb-day-dot';

    const nameIn = document.createElement('input');
    nameIn.className = 'wb-day-name';
    nameIn.type = 'text';
    nameIn.value = day.name;
    nameIn.placeholder = 'Day name...';
    // Clicking name selects day + allows editing
    nameIn.addEventListener('focus', function() { setActive(di); });
    nameIn.addEventListener('input', function() {
      days[di].name = nameIn.value;
      const lbl = document.getElementById('wb-active-label');
      if (lbl && di === activeDay) lbl.textContent = '● Adding exercises to: ' + nameIn.value;
    });

    // Clicking anywhere on header selects day
    hd.addEventListener('click', function(e) {
      if (e.target !== nameIn) { nameIn.focus(); }
      setActive(di);
    });

    const btns = document.createElement('div');
    btns.className = 'wb-day-btns';

    const selBtn = document.createElement('button');
    selBtn.className = 'wb-ico-btn sel';
    selBtn.title = 'Set active';
    selBtn.innerHTML = isAct ? '●' : '○';
    selBtn.addEventListener('click', function(e) { e.stopPropagation(); setActive(di); });

    const delBtn = document.createElement('button');
    delBtn.className = 'wb-ico-btn del';
    delBtn.title = 'Remove day';
    delBtn.innerHTML = '✕';
    delBtn.addEventListener('click', function(e) {
      e.stopPropagation();
      if (days.length <= 1) { toast('Cannot remove last day', 'err'); return; }
      days.splice(di, 1);
      if (activeDay >= days.length) activeDay = days.length - 1;
      renderDays();
      renderCoverage();
    });

    btns.appendChild(selBtn);
    btns.appendChild(delBtn);
    hd.appendChild(dot);
    hd.appendChild(nameIn);
    hd.appendChild(btns);

    // ── Body ──
    const body = document.createElement('div');
    body.className = 'wb-day-body';

    if (day.exercises.length === 0) {
      const empty = document.createElement('div');
      empty.className = 'wb-day-empty';
      empty.textContent = isAct ? '← Select an exercise from the library on the right' : 'No exercises added yet';
      body.appendChild(empty);
    } else {
      day.exercises.forEach(function(ex, ei) {
        const row = document.createElement('div');
        row.className = 'wb-ex-row';

        const dot2 = document.createElement('div');
        dot2.className = 'wb-ex-dot';
        dot2.style.background = MC[ex.muscle] || '#22C55E';

        const name = document.createElement('div');
        name.className = 'wb-ex-name';
        name.textContent = ex.name;
        name.title = ex.name;

        const sLbl = document.createElement('span');
        sLbl.className = 'wb-lbl';
        sLbl.textContent = 'Sets';

        const sIn = document.createElement('input');
        sIn.className = 'wb-setsreps';
        sIn.value = ex.sets;
        sIn.title = 'Sets';
        sIn.addEventListener('change', function() { days[di].exercises[ei].sets = sIn.value; renderCoverage(); });

        const x = document.createElement('span');
        x.className = 'wb-lbl';
        x.textContent = '×';

        const rIn = document.createElement('input');
        rIn.className = 'wb-setsreps';
        rIn.style.width = '58px';
        rIn.value = ex.reps;
        rIn.title = 'Reps';
        rIn.addEventListener('change', function() { days[di].exercises[ei].reps = rIn.value; });

        const del = document.createElement('button');
        del.className = 'wb-ex-del';
        del.innerHTML = '✕';
        del.title = 'Remove';
        del.addEventListener('click', function(e) {
          e.stopPropagation();
          days[di].exercises.splice(ei, 1);
          renderDays();
          renderCoverage();
        });

        row.appendChild(dot2);
        row.appendChild(name);
        row.appendChild(sLbl);
        row.appendChild(sIn);
        row.appendChild(x);
        row.appendChild(rIn);
        row.appendChild(del);
        body.appendChild(row);
      });
    }

    block.appendChild(hd);
    block.appendChild(body);
    container.appendChild(block);
  });
}

function setActive(di) {
  if (activeDay === di) return;
  activeDay = di;
  renderDays();
  toast('Active: ' + days[di].name);
}

// ── COVERAGE ──
function renderCoverage() {
  const wrap = document.getElementById('wb-coverage');
  if (!wrap) return;
  const counts = {};
  days.forEach(function(day) {
    day.exercises.forEach(function(ex) {
      const k = ex.muscle || 'Other';
      const s = parseInt(String(ex.sets).replace(/\D.*/, '')) || 3;
      counts[k] = (counts[k] || 0) + s;
    });
  });

  if (!Object.keys(counts).length) {
    wrap.innerHTML = '<div class="wb-empty"><div style="font-size:2rem;margin-bottom:6px;">📊</div>Add exercises to see your muscle coverage</div>';
    return;
  }

  wrap.innerHTML = '<p style="font-size:0.7rem;color:var(--text-3);margin-bottom:12px;">Optimal: 10–20 sets/week per muscle. ⚠️ = under-trained, 🔴 = excessive.</p>';
  const max = Math.max.apply(null, Object.values(counts).concat([20]));
  Object.entries(counts).sort(function(a,b){return b[1]-a[1];}).forEach(function(entry) {
    const muscle = entry[0], sets = entry[1];
    const pct = Math.round((sets / max) * 100);
    const color = MC[muscle] || '#22C55E';
    const status = sets < 8 ? ' ⚠️' : sets > 24 ? ' 🔴' : ' ✓';

    const row = document.createElement('div');
    row.className = 'wb-cov-row';

    const lbl = document.createElement('div');
    lbl.className = 'wb-cov-label';
    lbl.textContent = muscle;

    const track = document.createElement('div');
    track.className = 'wb-cov-track';
    const fill = document.createElement('div');
    fill.className = 'wb-cov-fill';
    fill.style.width = pct + '%';
    fill.style.background = color;
    track.appendChild(fill);

    const sl = document.createElement('div');
    sl.className = 'wb-cov-sets';
    sl.textContent = sets + 'x' + status;
    sl.style.color = sets < 8 ? '#F59E0B' : sets > 24 ? '#EF4444' : color;

    row.appendChild(lbl);
    row.appendChild(track);
    row.appendChild(sl);
    wrap.appendChild(row);
  });
}

// ── ADD EXERCISE ──
function addEx(slug) {
  const found = EXERCISES.find(function(e) { return e.slug === slug; });
  if (!found) return;
  if (!days.length) { toast('Add a day first', 'err'); return; }
  if (activeDay >= days.length) activeDay = 0;

  days[activeDay].exercises.push({
    slug: found.slug,
    name: found.name,
    muscle: found.muscle,
    sets: found.sets || '3',
    reps: found.reps || '10–12',
  });

  renderDays();
  renderCoverage();
  toast('✓ ' + found.name + ' → ' + days[activeDay].name);
}

// ── PICKER ──
function buildChips() {
  const c = document.getElementById('wb-chips');
  if (!c) return;
  c.innerHTML = '';
  CATS.forEach(function(cat) {
    const btn = document.createElement('button');
    btn.className = 'wb-chip' + (cat === filterCat ? ' on' : '');
    btn.textContent = cat;
    btn.addEventListener('click', function() {
      filterCat = cat;
      c.querySelectorAll('.wb-chip').forEach(function(b) { b.classList.remove('on'); });
      btn.classList.add('on');
      renderPicker();
    });
    c.appendChild(btn);
  });
}

function renderPicker() {
  const list = document.getElementById('wb-picker-list');
  const countEl = document.getElementById('wb-excount');
  if (!list) return;

  const q = searchQ.toLowerCase().trim();
  const filtered = EXERCISES.filter(function(ex) {
    const catOk = filterCat === 'All' || ex.category === filterCat;
    const qOk = !q || ex.name.toLowerCase().indexOf(q) !== -1 || ex.muscle.toLowerCase().indexOf(q) !== -1;
    return catOk && qOk;
  });

  if (countEl) countEl.textContent = filtered.length + ' exercises';

  list.innerHTML = '';
  if (!filtered.length) {
    list.innerHTML = '<div class="wb-empty">No exercises found</div>';
    return;
  }

  filtered.forEach(function(ex) {
    const color = MC[ex.muscle] || '#22C55E';
    const abbr = ex.category.slice(0,3).toUpperCase();

    const item = document.createElement('div');
    item.className = 'wb-pi';
    item.setAttribute('role', 'listitem');
    item.setAttribute('tabindex', '0');

    const badge = document.createElement('div');
    badge.className = 'wb-pi-badge';
    badge.style.background = color + '22';
    badge.style.color = color;
    badge.textContent = abbr;

    const info = document.createElement('div');
    info.className = 'wb-pi-info';
    const nm = document.createElement('div');
    nm.className = 'wb-pi-name';
    nm.textContent = ex.name;
    const sub = document.createElement('div');
    sub.className = 'wb-pi-sub';
    sub.textContent = ex.muscle + ' · ' + ex.difficulty;
    info.appendChild(nm);
    info.appendChild(sub);

    const plus = document.createElement('button');
    plus.className = 'wb-plus';
    plus.textContent = '+';
    plus.title = 'Add ' + ex.name;
    // Stop propagation so item click doesn't double-fire
    plus.addEventListener('click', function(e) {
      e.stopPropagation();
      addEx(ex.slug);
    });

    // Clicking anywhere on the row adds (except the + button which handles itself)
    item.addEventListener('click', function(e) {
      if (e.target !== plus) addEx(ex.slug);
    });
    item.addEventListener('keydown', function(e) {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); addEx(ex.slug); }
    });

    item.appendChild(badge);
    item.appendChild(info);
    item.appendChild(plus);
    list.appendChild(item);
  });
}

// ── SAVE / LOAD / PDF ──
function initButtons() {
  // Search
  const srch = document.getElementById('wb-search');
  if (srch) {
    srch.addEventListener('input', function() { searchQ = srch.value; renderPicker(); });
  }

  // Add day
  const addDayBtn = document.getElementById('wb-addday');
  if (addDayBtn) {
    addDayBtn.addEventListener('click', function() {
      const n = days.length + 1;
      const names = ['Push','Pull','Legs','Upper','Lower','Full Body','Shoulders & Arms','Chest & Back'];
      const label = 'Day ' + n + (names[n-1] ? ' — ' + names[n-1] : '');
      days.push({ name: label, exercises: [] });
      activeDay = days.length - 1;
      renderDays();
      renderCoverage();
      toast('Day ' + n + ' added!');
    });
  }

  // Plan name
  const pn = document.getElementById('wb-planname');
  if (pn) pn.addEventListener('input', function() {});

  // Save
  const saveBtn = document.getElementById('wb-save');
  if (saveBtn) {
    saveBtn.addEventListener('click', function() {
      try {
        const pname = document.getElementById('wb-planname');
        const data = { name: pname ? pname.value : 'My Plan', days: days, activeDay: activeDay, v: 3 };
        localStorage.setItem('sw_wb_v3', JSON.stringify(data));
        toast('💾 Workout saved!');
      } catch(e) { toast('Could not save — storage unavailable', 'err'); }
    });
  }

  // Load
  const loadBtn = document.getElementById('wb-load');
  if (loadBtn) {
    loadBtn.addEventListener('click', function() {
      try {
        const raw = localStorage.getItem('sw_wb_v3');
        if (!raw) { toast('No saved workout found', 'err'); return; }
        const data = JSON.parse(raw);
        days = data.days || [];
        activeDay = data.activeDay || 0;
        const pname = document.getElementById('wb-planname');
        if (pname && data.name) pname.value = data.name;
        renderDays();
        renderCoverage();
        toast('📂 Workout loaded!');
      } catch(e) { toast('Could not load workout', 'err'); }
    });
  }

  // PDF
  const pdfBtn = document.getElementById('wb-pdf');
  if (pdfBtn) {
    pdfBtn.addEventListener('click', function() {
      const pname = document.getElementById('wb-planname');
      const planName = pname ? pname.value || 'My Workout' : 'My Workout';

      const rows = days.map(function(d) {
        const exRows = d.exercises.map(function(ex) {
          return '<tr><td><label style="display:flex;align-items:center;gap:8px;cursor:pointer;"><input type="checkbox" style="width:14px;height:14px;"> ' + ex.name + '</label></td><td style="text-align:center;">' + ex.sets + '</td><td style="text-align:center;">' + ex.reps + '</td><td></td></tr>';
        }).join('');
        return '<div class="ds"><h3>' + d.name + '</h3><table><thead><tr><th>Exercise</th><th>Sets</th><th>Reps</th><th>Weight</th></tr></thead><tbody>' + (exRows || '<tr><td colspan="4" style="color:#9CA3AF;font-style:italic;padding:8px;">Rest day</td></tr>') + '</tbody></table></div>';
      }).join('');

      const html = '<!doctype html><html><head><meta charset="utf-8"><title>' + planName + '</title>' +
        '<style>*{box-sizing:border-box;margin:0;padding:0;}body{font-family:Arial,sans-serif;padding:28px 32px;color:#111827;font-size:13px;line-height:1.5;}' +
        '.hdr{border-bottom:3px solid #22C55E;padding-bottom:12px;margin-bottom:20px;}' +
        '.brand{font-size:1.2rem;font-weight:900;color:#22C55E;letter-spacing:-0.02em;}' +
        'h2{font-size:1.4rem;font-weight:800;margin-top:5px;}.sub{font-size:0.72rem;color:#9CA3AF;margin-top:3px;}' +
        '.ds{break-inside:avoid;margin-bottom:18px;}h3{font-size:0.9rem;font-weight:700;color:#374151;padding:7px 0 6px;border-bottom:2px solid #E5E7EB;margin-bottom:0;}' +
        'table{width:100%;border-collapse:collapse;}th{text-align:left;font-size:0.65rem;text-transform:uppercase;letter-spacing:0.06em;color:#9CA3AF;padding:6px 10px;background:#F9FAFB;border:1px solid #E5E7EB;}' +
        'td{padding:8px 10px;border:1px solid #E5E7EB;}tr:nth-child(even) td{background:#FAFAFA;}' +
        '.ftr{margin-top:24px;text-align:center;font-size:0.72rem;color:#9CA3AF;border-top:1px solid #E5E7EB;padding-top:12px;}' +
        '.print-btn{display:block;margin:16px auto 0;background:#22C55E;color:white;border:none;padding:10px 28px;border-radius:6px;font-size:0.9rem;font-weight:700;cursor:pointer;}' +
        '@media print{.print-btn{display:none!important;}}' +
        '</style></head><body>' +
        '<div class="hdr"><div class="brand">SplitsWorkout</div><h2>' + planName + '</h2><div class="sub">Generated: ' + new Date().toLocaleDateString() + ' · splitsworkout.com</div></div>' +
        rows +
        '<div class="ftr">SplitsWorkout.com — Free Workout Planning · Train Smarter</div>' +
        '<button class="print-btn" onclick="window.print()">🖨️ Print / Save as PDF</button>' +
        '</body></html>';

      const blob = new Blob([html], { type: 'text/html' });
      const url = URL.createObjectURL(blob);
      const pw = window.open(url, '_blank', 'width=900,height=700');
      if (pw) pw.onload = function() { setTimeout(function() { pw.print(); }, 400); };
      toast('📄 PDF ready — print dialog will open');
    });
  }
}

// ── INIT — wait for DOM ──
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', init);
} else {
  init();
}

function init() {
  buildChips();
  renderPicker();
  renderDays();
  renderCoverage();
  initButtons();
}
</script>

</Layout>
