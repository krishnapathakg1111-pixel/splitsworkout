  /* Toasts */
  #wb-toasts { position:fixed;bottom:24px;right:24px;z-index:9999;display:flex;flex-direction:column;gap:7px;pointer-events:none; }
  .wb-toast {
    background:#1F2937;color:white;padding:10px 16px;border-radius:var(--radius-lg);
    font-size:0.82rem;font-weight:500;box-shadow:0 4px 20px rgba(0,0,0,0.25);
    pointer-events:auto;border-left:3px solid #22C55E;max-width:280px;
