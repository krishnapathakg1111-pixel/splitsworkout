---
import Layout from '../../layouts/Layout.astro';
import CTA from '../../components/CTA.astro';
import { articleLd, SPLIT_NAMES } from '../../lib/seo';
import Mascot from '../../components/Mascot.astro';
import MuscleSVG from '../../components/MuscleSVG.astro';
import { getSplit } from '../../data/splits';

const split = getSplit('push-pull-legs')!;

const schemaData = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": split.name,
  "description": split.description,
  "author": { "@type": "Organization", "name": "SplitsWorkout" }
};
const schema = JSON.stringify(schemaData);

const dayColors = {
  'Push': '#EF4444', 'Pull': '#3B82F6', 'Legs': '#10B981', 'Rest': '#9CA3AF',
};
function getDayColor(focus: string): string {
  for (const [key, color] of Object.entries(dayColors)) {
    if (focus.includes(key)) return color;
  }
  return '#22C55E';
}
function getDayBg(focus: string): string {
  const c = getDayColor(focus);
  return focus.includes('Rest') ? 'var(--bg-2)' : c + '15';
}
function isRest(focus: string): boolean { return focus.toLowerCase().includes('rest'); }
---

<Layout
  title="Push Pull Legs (PPL) Workout Split: Complete Guide | SplitsWorkout"
  description="Complete push pull legs (PPL) workout guide: the 6-day schedule, exercises, sets and reps, muscle coverage, and who should (and should not) run it."
  canonical="/workout-splits/push-pull-legs"
  currentPage="splits"
  ogType="article"
  ogImage="/og/splits.png"
  breadcrumbs={[{ name: 'Workout Splits', url: '/workout-splits' }, { name: 'Push Pull Legs' }]}
  jsonLd={articleLd({ headline: split.name, description: split.description, path: '/workout-splits/push-pull-legs', image: '/og/splits.png' })}
>

<div class="page-header">
  <div class="page-header-inner">
    <h1 class="page-title">{split.name}</h1>
    <p class="page-desc">{split.longDescription}</p>
    <div class="page-meta">
      <span class={`tag diff-${split.difficulty.toLowerCase()}`}>{split.difficulty}</span>
      <span class="tag tag-green">📅 {split.daysPerWeek} days/week</span>
      <span class="tag tag-gray">⏱ {split.sessionDuration}</span>
      {split.goals.map(g => <span class="tag tag-purple">{g}</span>)}
    </div>
  </div>
</div>

<div class="content-wrap">
  <!-- Main Content -->
  <article class="content-article">
    <div class="prose">

      <!-- Weekly Schedule -->
      <h2>Weekly Schedule</h2>
      <div class="schedule-grid" style="grid-template-columns:repeat(7,1fr);">
        {split.schedule.map(day => {
          const rest = isRest(day.focus);
          return (
            <div class={rest ? 'schedule-day' : 'schedule-day training'}>
              <div class="schedule-day-name">{day.day.slice(0,3).toUpperCase()}</div>
              <div class="schedule-day-focus">{rest ? 'Rest' : day.focus.split('(')[0].trim()}</div>
            </div>
          );
        })}
      </div>

      <!-- Overview -->
      <h2>What is Push Pull Legs?</h2>
      <p>{split.overview}</p>
      <p>{split.whoIsItFor}</p>

      <!-- Pros/Cons -->
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin:24px 0;">
        <div style="background:var(--accent-bg);border:1px solid var(--accent-border);border-radius:var(--radius-lg);padding:20px;">
          <div style="font-family:'Poppins',sans-serif;font-weight:700;color:var(--accent-hover);margin-bottom:12px;font-size:0.9rem;">✅ Pros</div>
          <ul style="list-style:none;padding:0;margin:0;">
            {split.pros.map(p => <li style="font-size:0.85rem;color:var(--text-2);padding:4px 0;border-bottom:1px solid var(--accent-border);">{p}</li>)}
          </ul>
        </div>
        <div style="background:var(--bg-2);border:1px solid var(--border);border-radius:var(--radius-lg);padding:20px;">
          <div style="font-family:'Poppins',sans-serif;font-weight:700;color:var(--text-2);margin-bottom:12px;font-size:0.9rem;">⚠️ Cons</div>
          <ul style="list-style:none;padding:0;margin:0;">
            {split.cons.map(c => <li style="font-size:0.85rem;color:var(--text-2);padding:4px 0;border-bottom:1px solid var(--border);">{c}</li>)}
          </ul>
        </div>
      </div>

      <!-- The Programme -->
      <h2>The Complete Programme</h2>
      {split.schedule.filter(d => d.exercises.length > 0).map(day => (
        <div style="margin-bottom:24px;">
          <div style="display:flex;align-items:center;gap:10px;margin-bottom:12px;">
            <div style="padding:6px 14px;border-radius:var(--radius);font-family:'Poppins',sans-serif;font-weight:700;font-size:0.875rem;background:var(--accent-bg);color:var(--accent-hover);border:1px solid var(--accent-border);">{day.day}</div>
            <div style="font-family:'Poppins',sans-serif;font-weight:700;font-size:1.05rem;color:var(--text);">{day.focus}</div>
          </div>
          <table class="exercise-table">
            <thead>
              <tr>
                <th>Exercise</th>
                <th>Sets</th>
                <th>Reps</th>
                <th>Rest</th>
              </tr>
            </thead>
            <tbody>
              {day.exercises.map(ex => (
                <tr>
                  <td class="ex-name"><a href={`/exercises/${ex.slug}`}>{ex.name}</a>{ex.notes && <div style="font-size:0.72rem;color:var(--text-3);margin-top:2px;">{ex.notes}</div>}</td>
                  <td><span class="badge-pill">{ex.sets}</span></td>
                  <td><span class="badge-pill">{ex.reps}</span></td>
                  <td style="white-space:nowrap;">{ex.rest}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ))}

      <!-- Muscle Coverage -->
      <h2>Weekly Muscle Coverage</h2>
      <div style="background:var(--bg-2);border:1px solid var(--border);border-radius:var(--radius-xl);padding:24px;margin:16px 0;">
        {split.muscleCoverage.map(m => {
          const maxSets = Math.max(...split.muscleCoverage.map(x => x.setsPerWeek));
          const pct = Math.round(m.setsPerWeek / maxSets * 100);
          const colors = {'Chest':'#EF4444','Back':'#3B82F6','Shoulders':'#F59E0B','Biceps':'#8B5CF6','Triceps':'#A78BFA','Quads':'#10B981','Hamstrings':'#06B6D4','Glutes':'#EC4899','Calves':'#84CC16','Core':'#6B7280'};
          const color = (colors as any)[m.muscle] || '#22C55E';
          return (
            <div class="coverage-row">
              <div class="coverage-label">{m.muscle}</div>
              <div class="coverage-bar-track">
                <div class="coverage-bar-fill" style={`width:${pct}%;background:${color};`}></div>
              </div>
              <div class="coverage-sets">{m.setsPerWeek} sets</div>
            </div>
          );
        })}
      </div>

      <!-- FAQ -->

      <!-- Professor Splits tip -->
      <div style="background:var(--accent-bg);border:1px solid var(--accent-border);border-radius:var(--radius-xl);padding:20px;margin:24px 0;display:flex;align-items:flex-start;gap:14px;">
        <Mascot mood="explaining" size="sm" />
        <div>
          <div style="font-family:'Poppins',sans-serif;font-weight:700;font-size:0.875rem;color:var(--accent-hover);margin-bottom:4px;">Professor Splits Says:</div>
          <p style="font-size:0.85rem;color:var(--text-2);line-height:1.7;margin:0;">PPL is one of the most popular splits for good reason — it trains each muscle group twice per week with high volume. The 6-day version is demanding, but results are excellent for dedicated intermediate and advanced trainees.</p>
        </div>
      </div>

      <h2>Training schedules that fit this split</h2>
      <p>How you run this split depends on how many days you can train. These pages show sample weeks and alternatives for each schedule, and the <a href="/workout-split-finder">Split Finder</a> can check whether it suits your goal and experience.</p>
      <div class="seo-chips"><a class="seo-chip" href="/workout-splits/6-day">6-day version</a><a class="seo-chip" href="/workout-splits/5-day">5-day version</a><a class="seo-chip" href="/workout-splits/3-day">3-day version</a><a class="seo-chip" href="/workout-splits/ppl-vs-upper-lower">PPL vs Upper/Lower</a><a class="seo-chip" href="/workout-splits/ppl-vs-bro-split">PPL vs Bro Split</a><a class="seo-chip" href="/workout-splits/arnold-vs-ppl">Arnold vs PPL</a><a class="seo-chip" href="/workout-splits/best-workout-split">Compare all splits</a></div>
      <p>Explore the muscles this split trains in the <a href="/muscles">muscle guide</a>, or browse the <a href="/exercises">exercise library</a> for alternatives to any lift above.</p>
      <CTA variant="split" slug={split.slug} />

      <h2>Frequently Asked Questions</h2>
      <div style="margin-top:12px;">
        {split.faqs.map(faq => (
          <div class="faq-item">
            <div class="faq-q">
              <span>{faq.question}</span>
              <span class="faq-icon">▾</span>
            </div>
            <div class="faq-a">{faq.answer}</div>
          </div>
        ))}
      </div>

    </div>
  </article>

  <!-- Sidebar -->
  <aside class="content-sidebar">
    <!-- Quick stats -->
    <div class="sidebar-card">
      <div class="sidebar-card-title">Split Overview</div>
      <div class="sidebar-stat"><span>Days/Week</span><strong>{split.daysPerWeek}</strong></div>
      <div class="sidebar-stat"><span>Session Length</span><strong>{split.sessionDuration}</strong></div>
      <div class="sidebar-stat"><span>Difficulty</span><strong>{split.difficulty}</strong></div>
      <div class="sidebar-stat"><span>Equipment</span><strong>{split.equipment.join(', ')}</strong></div>
    </div>

    <!-- Muscle body -->
    <div class="sidebar-card" style="text-align:center;">
      <div class="sidebar-card-title">Muscles Trained</div>
      <MuscleSVG primary={['chest','back','shoulders']} secondary={['biceps','triceps','quads','hamstrings','glutes','calves']} size="md" view="both" />
      <p style="font-size:0.75rem;color:var(--text-3);margin-top:8px;">All major muscle groups trained twice weekly</p>
    </div>

    <!-- Related splits -->
    <div class="sidebar-card">
      <div class="sidebar-card-title">Related Splits</div>
      {(split.relatedSplits || []).slice(0,4).map(s => (
        <a href={"/workout-splits/"+s} class="sidebar-link">
          <span>{SPLIT_NAMES[s] ?? (/^\d-day$/.test(s) ? s[0] + '-Day Workout Split' : s)}</span>
          <span style="color:var(--accent);">→</span>
        </a>
      ))}
    </div>

    <!-- Build this workout CTA -->
    <div style="background:linear-gradient(135deg,var(--accent),var(--accent-hover));border-radius:var(--radius-xl);padding:20px;text-align:center;">
      <div style="font-size:1.5rem;margin-bottom:8px;">📋</div>
      <div style="font-family:'Poppins',sans-serif;font-weight:700;color:#fff;margin-bottom:6px;">Build This Workout</div>
      <p style="font-size:0.8rem;color:rgba(255,255,255,0.85);margin-bottom:14px;">Load this split into the workout builder and customize it to your needs.</p>
      <a href={`/workout-planner?split=${split.slug}`} class="btn" style="background:#fff;color:var(--accent);border-color:#fff;width:100%;justify-content:center;font-weight:700;">Open Builder →</a>
    </div>

    <!-- Free tools -->
    <div class="sidebar-card">
      <div class="sidebar-card-title">Free Tools</div>
      <a href="/calculators/tdee" class="sidebar-link"><span>🔥 TDEE Calculator</span><span style="color:var(--accent);font-size:0.75rem;">Free</span></a>
      <a href="/calculators/macros" class="sidebar-link"><span>🥩 Macro Calculator</span><span style="color:var(--accent);font-size:0.75rem;">Free</span></a>
      <a href="/calculators/bmi" class="sidebar-link"><span>⚖️ BMI Calculator</span><span style="color:var(--accent);font-size:0.75rem;">Free</span></a>
    </div>
  </aside>
</div>

</Layout>
