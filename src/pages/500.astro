---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Server Error | SplitsWorkout" description="Something went wrong on SplitsWorkout. Please try again in a moment." canonical="/500" currentPage="" noindex={true}>
<div style="display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:65vh;text-align:center;padding:48px 24px;">
  <!-- Idea mascot for 500 -->
  <div style="width:140px;height:140px;background-image:url('/mascot-expressions-2.webp');background-size:300% 200%;background-position:0% 100%;background-repeat:no-repeat;margin:0 auto 20px;" role="img" aria-label="Professor Splits thinking"></div>
  <h1 style="font-family:'Poppins',sans-serif;font-size:2.25rem;font-weight:800;color:var(--text);margin-bottom:10px;letter-spacing:-0.03em;">Something Went Wrong</h1>
  <p style="color:var(--text-3);margin-bottom:28px;max-width:380px;font-size:0.9rem;">Professor Splits is on the case. Please try again in a moment.</p>
  <a href="/" class="btn btn-primary">Go Home</a>
</div>
</Layout>
