---
import Layout from '../layouts/Layout.astro';
import { exercises, getExercise } from '../data/exercises';
import { splits } from '../data/splits';
import { muscles } from '../data/muscles';
import MuscleSVG from '../components/MuscleSVG.astro';
import { webAppLd, isIndexableExercise, isHiddenExercise, visibleOnly } from '../lib/seo';
const libCount = visibleOnly(exercises).length;
import { rankSwaps, coreEquipment, PRESETS } from '../lib/swapEngine';

const exData = exercises.map(e => ({
  slug: e.slug,
  name: e.name,
  category: e.category,
  muscle: e.primaryMuscle,
  sets: e.sets,
  reps: e.reps,
  rest: e.rest,
  sec: e.secondaryMuscles,
  eq: coreEquipment(e),
  ok: isIndexableExercise(e.slug),
  hidden: isHiddenExercise(e.slug),
  difficulty: e.difficulty,
}));
// Precomputed swap candidates (slugs only) — same engine as the exercise pages.
// Weekly-set targets come from the muscle guide (single source of truth).
const targets = Object.fromEntries(muscles.map((m) => [m.slug, m.weeklyVolume]));
const swaps = Object.fromEntries(exercises.map((e) => [e.slug, rankSwaps(e, exercises, 10, '', (s) => !isIndexableExercise(s)).map((s) => s.slug)]));

// Split templates for ?split=<slug>&days=<n> deep links (one canonical dataset: splits.ts → exercises.ts)
const splitTemplates = Object.fromEntries(splits.map((s) => [s.slug, {
  title: s.shortName + ' Plan',
  days: s.schedule.filter((d) => !d.focus.toLowerCase().includes('rest')).map((d) => ({
    focus: d.focus.split('(')[0].trim(),
    exercises: d.exercises.map((e) => { const ex = getExercise(e.slug); return { slug: e.slug, name: ex?.name ?? e.name, muscle: ex?.primaryMuscle ?? 'Full Body', sets: e.sets, reps: e.reps }; }),
  })),
}]));
const plannerDesc = 'Free workout planner and builder: pick exercises from a library of ' + libCount + ', set sets and reps, see weekly muscle coverage, and export a printable plan.';
---

<Layout
  title="Free Workout Planner & Workout Builder | SplitsWorkout"
  description={plannerDesc}
  canonical="/workout-planner"
  currentPage="planner"
  ogImage="/og/tools.png"
  breadcrumbs={[{ name: 'Workout Planner' }]}
  jsonLd={webAppLd({ name: 'SplitsWorkout Workout Planner', description: plannerDesc, path: '/workout-planner', category: 'HealthApplication' })}
>

<div class="page-header">
  <div class="page-header-inner">
    <h1 class="page-title">Build Your Workout With the Free Workout Planner</h1>
    <p class="page-desc">Create a weekly training plan from a searchable exercise library, edit sets and reps, watch your muscle coverage update as you add exercises, and export a printable PDF. No account needed.</p>
    <div class="page-meta">
      <span class="tag tag-green">✓ Free forever</span>
      <span class="tag tag-purple">📄 PDF export</span>
      <span class="tag tag-gray">💾 Saves locally</span>
    </div>
  </div>
</div>

<div id="wb-root">
  <div id="wb-left">
    <!-- TOP BAR -->
    <div class="wb-card" style="margin-bottom:14px;">
      <div class="wb-card-hd">
        <span class="wb-card-title">📋 My Workout</span>
        <div style="display:flex;gap:8px;">
          <button id="wb-save" class="btn btn-secondary btn-sm">💾 Save</button>
          <button id="wb-load" class="btn btn-ghost btn-sm">📂 Load</button>
          <button id="wb-pdf" class="btn btn-primary btn-sm">📄 Export PDF</button>
        </div>
      </div>
      <div style="padding:12px 20px;">
        <input id="wb-planname" type="text" value="My Workout Plan" placeholder="Workout name..."
          style="width:100%;background:transparent;border:none;outline:none;font-family:'Poppins',sans-serif;font-size:1.1rem;font-weight:700;color:var(--text);" />
      </div>
    </div>

    <!-- ACTIVE DAY INDICATOR -->
    <div id="wb-active-label" style="font-size:0.78rem;font-weight:700;color:var(--accent);margin-bottom:10px;padding:0 2px;"></div>

    <!-- DAYS -->
    <div id="wb-days"></div>

    <!-- ADD DAY -->
    <button id="wb-addday" class="wb-addbtn">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      Add Training Day
    </button>

    <!-- COVERAGE -->
    <div class="wb-card" style="margin-top:18px;">
      <div class="wb-card-hd">
        <span class="wb-card-title">💪 Weekly Muscle Coverage</span>
        <span style="font-size:0.72rem;color:var(--text-3);">Targets from the <a href="/muscles" style="color:var(--accent-hover);font-weight:600;">muscle guide</a></span>
      </div>
      <div id="wb-cov-grid">
        <div id="wb-coverage">
          <div class="wb-empty"><div style="font-size:2rem;margin-bottom:6px;">📊</div>Add exercises to see your muscle coverage</div>
        </div>
        <div id="wb-heat" aria-label="Muscle coverage map">
          <MuscleSVG size="lg" view="both" />
          <div class="wb-legend"><span><i class="lg-none"></i>None</span><span><i class="lg-low"></i>Low</span><span><i class="lg-ok"></i>On target</span><span><i class="lg-high"></i>High</span></div>
        </div>
      </div>
      <div id="wb-insights"></div>
    </div>
  </div>

  <!-- RIGHT: PICKER -->
  <div id="wb-right">
    <div class="wb-card" style="position:sticky;top:88px;">
      <div class="wb-card-hd">
        <span class="wb-card-title">🏋️ Exercise Library</span>
        <span id="wb-excount" style="font-size:0.7rem;color:var(--text-3);font-weight:500;"></span>
      </div>

      <div id="wb-picker-controls">
        <!-- Search -->
        <div style="position:relative;margin-bottom:10px;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            style="position:absolute;left:11px;top:50%;transform:translateY(-50%);color:var(--text-4);pointer-events:none;">
            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
          </svg>
          <input id="wb-search" type="search" placeholder={`Search ${libCount} exercises...`} autocomplete="off"
            style="width:100%;height:40px;padding:0 12px 0 34px;border:1.5px solid var(--border);border-radius:var(--radius-lg);
                   background:var(--bg-2);color:var(--text);font-size:0.82rem;outline:none;box-sizing:border-box;" />
        </div>
        <!-- Category chips -->
        <div id="wb-chips" style="display:flex;flex-wrap:wrap;gap:5px;"></div>
      </div>

      <div id="wb-picker-list" role="list"></div>

      <div style="padding:9px 14px;text-align:center;font-size:0.7rem;color:var(--text-3);border-top:1px solid var(--border);">
        Tap <strong>+</strong> to add to the active day
      </div>
    </div>
  </div>
</div>


<div class="seo-page" style="padding-top:0;">
  <h2>How the free workout planner works</h2>
  <p>The workout planner turns a list of exercises into a weekly training plan. Choose how many training days you want, name each day, then add exercises from the library. Each exercise arrives with a sensible default for sets and reps that you can edit, and the muscle coverage chart updates immediately so you can see whether your week is balanced.</p>
  <h2>What you can do in the planner</h2>
  <ul>
    <li><strong>Start from a proven split.</strong> Load push pull legs, upper/lower, full body, bro split or Arnold split as a starting point, then change anything.</li>
    <li><strong>Search and filter the exercise library</strong> by name, muscle or category — {libCount} exercises across every major muscle group, including machine, cable, dumbbell, barbell and bodyweight options.</li>
    <li><strong>Edit sets, reps, rest and notes</strong> for every exercise, and rename or remove training days.</li>
    <li><strong>Reorder, duplicate and swap.</strong> Move exercises up or down, duplicate one, or swap it for a ranked substitute — filter by the equipment you have (no barbell, dumbbells only, no cable, bodyweight).</li>
    <li><strong>See weekly muscle coverage.</strong> Sets are added up per muscle (secondary muscles count as a quarter of a set) and compared with the weekly range for that muscle in our guide. A colour-coded anatomy map shows what is low, on target or high, and you get push/pull and upper/lower balance checks, how often each muscle is trained, and one-click suggestions for muscles you are missing.</li>
    <li><strong>Save and export.</strong> Save your plan in your browser and export a printable workout sheet with checkboxes for each exercise.</li>
  </ul>
  <h2>Where your workout is stored</h2>
  <p>Plans are saved in your own browser using local storage. We do not create accounts or upload your workouts, which also means a plan will not follow you to another device — export it to take it with you.</p>
  <h2>Need help choosing a split first?</h2>
  <p>If you are not sure how to divide your week, the <a href="/workout-split-finder">Split Finder</a> recommends a structure from your schedule, goal and experience and opens it here. You can also read how to choose in our guide to the <a href="/workout-splits/best-workout-split">best workout split</a>, browse the <a href="/exercises">exercise library</a>, or work out your calorie target with the <a href="/calculators/tdee">TDEE calculator</a>.</p>
</div>

<!-- Toasts -->
<div id="wb-toasts"></div>

<style is:global>
  /* ── WORKOUT BUILDER — all styles must be global for JS-created elements ── */
  #wb-root {
    max-width: 1300px;
    margin: 0 auto;
    padding: 20px 24px 60px;
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 20px;
    align-items: start;
  }
  @media(max-width:1024px) {
    #wb-root { grid-template-columns: 1fr !important; }
    #wb-right { position: static !important; }
  }

  /* Cards */
  .wb-card { background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-xl);overflow:hidden; }
  .wb-card-hd {
    display:flex;align-items:center;justify-content:space-between;
    padding:12px 20px;border-bottom:1px solid var(--border);background:var(--bg-2);
  }
  .wb-card-title { font-family:'Poppins',sans-serif;font-weight:700;font-size:0.875rem;color:var(--text); }

  /* Add day button */
  .wb-addbtn {
    width:100%;margin-top:10px;padding:14px;border:1.5px dashed var(--border);
    border-radius:var(--radius-xl);background:transparent;color:var(--text-3);
    font-size:0.82rem;font-weight:600;cursor:pointer;
    display:flex;align-items:center;justify-content:center;gap:8px;transition:all 0.15s;
  }
  .wb-addbtn:hover { border-color:var(--accent);color:var(--accent);background:var(--accent-bg); }

  /* Empty states */
  .wb-empty { text-align:center;padding:24px;color:var(--text-3);font-size:0.82rem;line-height:1.6; }

  /* ── DAY BLOCKS ── */
  .wb-day {
    background:var(--surface);border:1.5px solid var(--border);
    border-radius:var(--radius-xl);margin-bottom:12px;overflow:hidden;
    transition:border-color 0.15s,box-shadow 0.15s;
  }
  .wb-day.active {
    border-color:var(--accent);
    box-shadow:0 0 0 3px rgba(34,197,94,0.12);
  }
  .wb-day-hd {
    display:flex;align-items:center;gap:10px;padding:11px 16px;
    background:var(--bg-2);border-bottom:1px solid var(--border);
    cursor:pointer;transition:background 0.15s;
  }
  .wb-day.active .wb-day-hd { background:rgba(34,197,94,0.08); }
  .wb-day-dot {
    width:10px;height:10px;border-radius:50%;background:var(--border-strong);
    flex-shrink:0;transition:background 0.15s;
  }
  .wb-day.active .wb-day-dot { background:var(--accent); }
  .wb-day-name {
    flex:1;min-width:0;background:transparent;border:none;outline:none;
    font-family:'Poppins',sans-serif;font-weight:700;font-size:0.875rem;
    color:var(--text);cursor:pointer;
  }
  .wb-day-name:focus { cursor:text; }
  .wb-day-btns { display:flex;gap:4px;margin-left:auto;flex-shrink:0; }
  .wb-ico-btn {
    border:1px solid var(--border);background:transparent;border-radius:var(--radius);
    width:28px;height:28px;display:flex;align-items:center;justify-content:center;
    cursor:pointer;font-size:0.75rem;color:var(--text-3);transition:all 0.15s;
  }
  .wb-ico-btn.sel:hover { border-color:var(--accent);color:var(--accent);background:var(--accent-bg); }
  .wb-ico-btn.del:hover { border-color:#EF4444;color:#EF4444;background:rgba(239,68,68,0.08); }

  /* Exercise rows inside days */
  .wb-day-body { padding:10px 12px 12px; }
  .wb-ex-row {
    display:flex;align-items:center;gap:8px;padding:9px 10px;
    border:1px solid var(--border);border-radius:var(--radius);
    margin-bottom:6px;background:var(--bg-2);font-size:0.82rem;
  }
  .wb-ex-dot { width:8px;height:8px;border-radius:50%;flex-shrink:0; }
  .wb-ex-name {
    flex:1;min-width:0;font-weight:600;color:var(--text);
    overflow:hidden;text-overflow:ellipsis;white-space:nowrap;
  }
  .wb-lbl { font-size:0.62rem;color:var(--text-4);white-space:nowrap; }
  .wb-setsreps {
    width:44px;height:28px;border:1px solid var(--border);border-radius:var(--radius);
    background:var(--surface);color:var(--text);text-align:center;
    font-size:0.78rem;font-weight:600;outline:none;padding:0 4px;
  }
  .wb-setsreps:focus { border-color:var(--accent); }
  .wb-ex-del {
    background:transparent;border:none;color:var(--text-4);cursor:pointer;
    padding:2px 6px;border-radius:4px;font-size:0.85rem;transition:color 0.12s;
  }
  .wb-ex-del:hover { color:#EF4444; }
  .wb-day-empty { padding:14px 0;text-align:center;font-size:0.78rem;color:var(--text-4); }

  /* ── EXERCISE PICKER ── */
  #wb-picker-controls { padding:12px 14px;border-bottom:1px solid var(--border); }

  /* Category filter chips */
  .wb-chip {
    border:1.5px solid var(--border);background:transparent;border-radius:100px;
    padding:4px 12px;font-size:0.72rem;font-weight:600;color:var(--text-3);
    cursor:pointer;transition:all 0.12s;white-space:nowrap;
  }
  .wb-chip:hover { border-color:var(--accent);color:var(--accent); }
  .wb-chip.on { background:var(--accent);border-color:var(--accent);color:white; }

  /* Exercise list */
  #wb-picker-list { max-height:460px;overflow-y:auto; }
  .wb-pi {
    display:flex;align-items:center;gap:10px;padding:11px 14px;
    border-bottom:1px solid var(--border);cursor:pointer;
    transition:background 0.1s;user-select:none;
  }
  .wb-pi:last-child { border-bottom:none; }
  .wb-pi:hover { background:var(--bg-2); }
  .wb-pi-badge {
    width:40px;height:40px;border-radius:var(--radius);display:flex;
    align-items:center;justify-content:center;flex-shrink:0;
    font-weight:800;font-size:0.62rem;letter-spacing:0.02em;
  }
  .wb-pi-info { flex:1;min-width:0; }
  .wb-pi-name {
    font-weight:700;font-size:0.875rem;color:var(--text);
    overflow:hidden;text-overflow:ellipsis;white-space:nowrap;
  }
  .wb-pi-sub { font-size:0.7rem;color:var(--text-3);margin-top:2px; }

  /* The + add button */
  .wb-plus {
    width:36px;height:36px;border-radius:var(--radius);
    background:var(--accent);border:none;color:white;
    font-size:1.4rem;font-weight:700;cursor:pointer;
    display:flex;align-items:center;justify-content:center;
    flex-shrink:0;transition:all 0.12s;line-height:1;
  }
  .wb-plus:hover { background:#16A34A;transform:scale(1.1); }
  .wb-plus:active { transform:scale(0.93); }

  /* ── COVERAGE BARS ── */
  .wb-cov-row {
    display:grid;grid-template-columns:96px 1fr 54px;
    align-items:center;gap:8px;margin-bottom:9px;
  }
  .wb-cov-label { font-size:0.78rem;font-weight:600;color:var(--text-2); }
  .wb-cov-track { height:8px;border-radius:100px;background:var(--bg-3);overflow:hidden; }
  .wb-cov-fill { height:100%;border-radius:100px;transition:width 0.4s ease; }
  .wb-cov-sets { font-size:0.7rem;font-weight:700;text-align:right; }

  /* ── COVERAGE v2 ── */
  #wb-cov-grid { display:grid; grid-template-columns:1fr auto; gap:20px; padding:16px 20px; align-items:start; }
  @media(max-width:700px){ #wb-cov-grid { grid-template-columns:1fr; } #wb-heat { order:-1; } }
  #wb-heat { text-align:center; }
  .wb-legend { display:flex; flex-wrap:wrap; gap:10px; justify-content:center; margin-top:6px; font-size:0.65rem; color:var(--text-3); }
  .wb-legend i { display:inline-block; width:9px; height:9px; border-radius:50%; margin-right:4px; vertical-align:middle; }
  .lg-none { background:#9CA3AF; opacity:.5; } .lg-low { background:#F59E0B; } .lg-ok { background:#22C55E; } .lg-high { background:#EF4444; }
  .wb-cov-note { font-size:0.7rem; color:var(--text-3); margin:0 0 10px; line-height:1.5; }
  .wb-cov-row2 { display:grid; grid-template-columns:84px 1fr 62px 28px; align-items:center; gap:8px; margin-bottom:7px; }
  .wb-cov-ind { opacity:.45; }
  .wb-cov-target { position:absolute; top:-2px; bottom:-2px; width:2px; background:var(--text-3); opacity:.55; border-radius:2px; }
  .wb-cov-nums { font-size:0.72rem; font-weight:700; text-align:right; white-space:nowrap; }
  .wb-cov-freq { font-size:0.68rem; color:var(--text-3); text-align:right; }
  #wb-insights:not(:empty) { border-top:1px solid var(--border); padding:14px 20px 16px; }
  .wb-ins-list { margin:0; padding-left:18px; font-size:0.8rem; line-height:1.7; color:var(--text-2); }
  .wb-fix { display:flex; flex-wrap:wrap; align-items:center; gap:6px; margin-top:10px; font-size:0.75rem; color:var(--text-3); }
  .wb-fix-btn { border:1.5px solid var(--accent-border); background:var(--accent-bg); color:var(--accent-hover); border-radius:100px; padding:3px 12px; font-size:0.72rem; font-weight:700; cursor:pointer; }
  .wb-fix-btn:hover { background:var(--accent); color:#fff; border-color:var(--accent); }

  /* ── EXERCISE ROW ACTIONS / NOTES / SWAP ── */
  .wb-ex-wrap { margin-bottom:8px; }
  .wb-ex-wrap .wb-ex-row { flex-wrap:wrap; margin-bottom:0; }
  .wb-ex-name { min-width:120px; }
  .wb-ex-btn { border:1px solid var(--border); background:transparent; color:var(--text-3); border-radius:6px; width:26px; height:26px; font-size:0.72rem; cursor:pointer; display:inline-flex; align-items:center; justify-content:center; padding:0; }
  .wb-ex-btn:hover:not(:disabled) { border-color:var(--accent); color:var(--accent); background:var(--accent-bg); }
  .wb-ex-btn:disabled { opacity:.3; cursor:default; }
  .wb-ex-btn.del:hover { border-color:#EF4444; color:#EF4444; background:rgba(239,68,68,.08); }
  .wb-notes { width:100%; margin-top:4px; border:1px dashed var(--border); border-radius:var(--radius); background:transparent; color:var(--text-2); font-size:0.75rem; padding:6px 10px; outline:none; box-sizing:border-box; }
  .wb-notes:focus { border-color:var(--accent); border-style:solid; }
  .wb-swap { margin-top:6px; padding:12px 14px; border:1px solid var(--accent-border); background:var(--accent-bg); border-radius:var(--radius-lg); }
  .wb-swap-title { font-size:0.78rem; font-weight:700; color:var(--text); margin-bottom:8px; }
  .wb-swap-chips { display:flex; flex-wrap:wrap; gap:5px; margin-bottom:10px; }
  .wb-swap-chip { border:1.5px solid var(--border); background:var(--surface); color:var(--text-2); border-radius:100px; padding:3px 10px; font-size:0.68rem; font-weight:700; cursor:pointer; }
  .wb-swap-chip.on { background:var(--accent); border-color:var(--accent); color:#fff; }
  .wb-swap-opt { display:flex; justify-content:space-between; align-items:center; gap:10px; width:100%; text-align:left; border:1px solid var(--border); background:var(--surface); border-radius:var(--radius); padding:8px 12px; margin-bottom:5px; cursor:pointer; }
  .wb-swap-opt:hover { border-color:var(--accent); }
  .wb-swap-opt strong { font-size:0.8rem; color:var(--text); }
  .wb-swap-opt span { font-size:0.68rem; color:var(--text-3); white-space:nowrap; }
  .wb-swap-empty { font-size:0.75rem; color:var(--text-3); }

  /* ── TOASTS ── */
  #wb-toasts {
    position:fixed;bottom:24px;right:24px;z-index:9999;
    display:flex;flex-direction:column;gap:7px;pointer-events:none;
  }
  .wb-toast {
    background:#1F2937;color:white;padding:10px 16px;border-radius:var(--radius-lg);
    font-size:0.82rem;font-weight:500;box-shadow:0 4px 20px rgba(0,0,0,0.25);
    pointer-events:auto;border-left:3px solid #22C55E;max-width:280px;
    animation:wbIn 0.18s ease;
  }
  .wb-toast.err { border-left-color:#EF4444; }
  .wb-toast.bye { animation:wbOut 0.22s ease forwards; }
  @keyframes wbIn { from{opacity:0;transform:translateY(6px)} to{opacity:1;transform:translateY(0)} }
  @keyframes wbOut { to{opacity:0;transform:translateY(6px)} }

  /* ── SEARCH INPUT ── */
  #wb-search {
    width:100%;height:40px;padding:0 12px 0 34px;
    border:1.5px solid var(--border);border-radius:var(--radius-lg);
    background:var(--bg-2);color:var(--text);font-size:0.82rem;outline:none;
    box-sizing:border-box;transition:border-color 0.15s;
  }
  #wb-search:focus { border-color:var(--accent); }
  #wb-search::placeholder { color:var(--text-4); }

  .wb-card { background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-xl);overflow:hidden; }
  .wb-card-hd { display:flex;align-items:center;justify-content:space-between;padding:12px 20px;border-bottom:1px solid var(--border);background:var(--bg-2); }
  .wb-card-title { font-family:'Poppins',sans-serif;font-weight:700;font-size:0.875rem;color:var(--text); }

  .wb-addbtn {
    width:100%;margin-top:10px;padding:14px;border:1.5px dashed var(--border);border-radius:var(--radius-xl);
    background:transparent;color:var(--text-3);font-size:0.82rem;font-weight:600;cursor:pointer;
    display:flex;align-items:center;justify-content:center;gap:8px;transition:all 0.15s;
  }
