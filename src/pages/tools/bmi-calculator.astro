---
import Layout from '../../layouts/Layout.astro';
const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "What is a healthy BMI?", "acceptedAnswer": { "@type": "Answer", "text": "A BMI between 18.5 and 24.9 is generally considered healthy for most adults. However, BMI does not account for muscle mass, bone density, or body fat distribution, so athletes and muscular individuals may have high BMI without excess fat." } },
    { "@type": "Question", "name": "Is BMI accurate for athletes?", "acceptedAnswer": { "@type": "Answer", "text": "BMI is a poor indicator for athletes. Muscle weighs more than fat, so athletes often fall in the 'overweight' BMI category despite having low body fat. For athletes, body fat percentage is a more meaningful measure." } }
  ]
});
---
<Layout
  title="BMI Calculator — Body Mass Index | SplitsWorkout"
  description="Free BMI calculator with cm and feet/inches support. Calculate your Body Mass Index and understand what it means for your fitness goals."
  canonical="/tools/bmi-calculator"
  currentPage="tools"
  schema={schema}
>
<div class="page-header">
  <div class="page-header-inner">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a><span class="breadcrumb-sep">›</span>
      <span>BMI Calculator</span>
    </nav>
    <h1 class="page-title">BMI Calculator</h1>
    <p class="page-desc">Calculate your Body Mass Index using your height and weight. Supports both metric (cm/kg) and imperial (ft/in/lbs) units.</p>
    <div class="page-meta">
      <span class="tag tag-green">🔢 Instant Results</span>
      <span class="tag tag-gray">cm or ft/in</span>
    </div>
  </div>
</div>

<div style="max-width:600px;margin:0 auto;padding:40px 24px 64px;">

  <div style="background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-2xl);padding:32px;margin-bottom:20px;">
    <h2 style="font-family:'Poppins',sans-serif;font-size:1rem;font-weight:700;color:var(--text);margin-bottom:20px;">Your Measurements</h2>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:20px;">

      <!-- Height with toggle -->
      <div style="grid-column:1/-1;">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;">
          <label style="font-size:0.75rem;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:var(--text-3);">Height</label>
          <div style="display:flex;background:var(--bg-2);border:1px solid var(--border);border-radius:var(--radius);padding:2px;gap:2px;">
            <button id="bmi-hcm" class="unit-btn active" onclick="setBMIHeight('cm')">cm</button>
            <button id="bmi-hft" class="unit-btn" onclick="setBMIHeight('ft')">ft/in</button>
          </div>
        </div>
        <div id="bmi-cm-wrap">
          <input type="number" id="height-cm" value="175" min="100" max="250" class="search-input" style="height:48px;width:100%;font-size:1rem;" placeholder="Height in cm" />
        </div>
        <div id="bmi-ft-wrap" style="display:none;grid-template-columns:1fr 1fr;gap:8px;">
          <div>
            <input type="number" id="height-ft" value="5" min="3" max="7" class="search-input" style="height:48px;width:100%;font-size:1rem;" placeholder="Feet" />
            <div style="font-size:0.7rem;color:var(--text-4);text-align:center;margin-top:3px;">feet</div>
          </div>
          <div>
            <input type="number" id="height-in" value="9" min="0" max="11" class="search-input" style="height:48px;width:100%;font-size:1rem;" placeholder="Inches" />
            <div style="font-size:0.7rem;color:var(--text-4);text-align:center;margin-top:3px;">inches</div>
          </div>
        </div>
      </div>

      <!-- Weight with toggle -->
      <div style="grid-column:1/-1;">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;">
          <label style="font-size:0.75rem;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:var(--text-3);">Weight</label>
          <div style="display:flex;background:var(--bg-2);border:1px solid var(--border);border-radius:var(--radius);padding:2px;gap:2px;">
            <button id="bmi-wkg" class="unit-btn active" onclick="setBMIWeight('kg')">kg</button>
            <button id="bmi-wlb" class="unit-btn" onclick="setBMIWeight('lbs')">lbs</button>
          </div>
        </div>
        <input type="number" id="weight" value="75" class="search-input" style="height:48px;width:100%;font-size:1rem;" />
        <div id="bmi-wlabel" style="font-size:0.7rem;color:var(--text-4);margin-top:3px;">kilograms</div>
      </div>

    </div>

    <button id="calc-btn" class="btn btn-primary btn-lg" style="width:100%;justify-content:center;">Calculate BMI →</button>
    <div id="result" style="display:none;margin-top:20px;"></div>
  </div>

  <!-- BMI Categories -->
  <div style="background:var(--bg-2);border:1px solid var(--border);border-radius:var(--radius-xl);padding:24px;margin-bottom:20px;">
    <h2 style="font-size:1rem;font-weight:700;color:var(--text);margin-bottom:14px;">BMI Categories</h2>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
      {[
        ['Underweight','< 18.5','#3B82F6'],
        ['Normal Weight','18.5–24.9','#22C55E'],
        ['Overweight','25–29.9','#F59E0B'],
        ['Obese','≥ 30','#EF4444']
      ].map(([cat,range,color]) => (
        <div style={`padding:12px 14px;border-radius:var(--radius);background:${color}15;border:1px solid ${color}30;`}>
          <div style={`font-weight:700;color:${color};font-size:0.875rem;`}>{cat}</div>
          <div style="color:var(--text-3);font-size:0.78rem;">{range}</div>
        </div>
      ))}
    </div>
    <p style="font-size:0.78rem;color:var(--text-3);margin-top:14px;line-height:1.7;">BMI is a simple screening tool, not a diagnostic measure. Athletes with high muscle mass often have elevated BMI without excess body fat.</p>
  </div>

  <!-- FAQ -->
  <div style="background:var(--bg-2);border:1px solid var(--border);border-radius:var(--radius-xl);padding:24px;">
    <h2 style="font-size:1rem;font-weight:700;color:var(--text);margin-bottom:14px;">FAQ</h2>
    <div class="faq-item">
      <div class="faq-q"><span>What is a healthy BMI?</span><span class="faq-icon">▾</span></div>
      <div class="faq-a">A BMI between 18.5 and 24.9 is considered healthy for most adults. However, BMI doesn't account for muscle mass or body composition — it's just one screening tool.</div>
    </div>
    <div class="faq-item">
      <div class="faq-q"><span>Is BMI accurate for athletes?</span><span class="faq-icon">▾</span></div>
      <div class="faq-a">BMI is unreliable for athletes. Muscle weighs more than fat, so muscular individuals often fall in the 'overweight' BMI range despite excellent body composition. Use body fat percentage for a better measure.</div>
    </div>
    <div class="faq-item">
      <div class="faq-q"><span>What should I do if my BMI is high?</span><span class="faq-icon">▾</span></div>
      <div class="faq-a">A high BMI may suggest excess body fat, but consult a healthcare professional for proper assessment. Combined with regular exercise and a balanced diet, gradual fat loss is the healthiest approach.</div>
    </div>
  </div>

  <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:20px;">
    <a href="/tools/tdee-calculator" class="btn btn-secondary">TDEE Calculator →</a>
    <a href="/tools/macro-calculator" class="btn btn-secondary">Macro Calculator →</a>
  </div>
</div>

<style>
.unit-btn { background:transparent;border:none;padding:4px 10px;border-radius:4px;font-size:0.78rem;font-weight:600;color:var(--text-3);cursor:pointer;transition:all 0.15s; }
.unit-btn.active { background:var(--accent);color:white; }
.unit-btn:hover:not(.active) { color:var(--text);background:var(--bg-3); }
#bmi-ft-wrap.show { display:grid !important;grid-template-columns:1fr 1fr;gap:8px; }
#bmi-cm-wrap.hide { display:none; }
</style>

<script>
let bmiHUnit = 'cm';
let bmiWUnit = 'kg';

window.setBMIHeight = function(unit: string) {
  bmiHUnit = unit;
  const cmBtn = document.getElementById('bmi-hcm');
  const ftBtn = document.getElementById('bmi-hft');
  const cmWrap = document.getElementById('bmi-cm-wrap');
  const ftWrap = document.getElementById('bmi-ft-wrap');
  if (unit === 'cm') {
    cmBtn?.classList.add('active'); ftBtn?.classList.remove('active');
    cmWrap?.classList.remove('hide');
    if (ftWrap) { ftWrap.style.display = 'none'; ftWrap.classList.remove('show'); }
  } else {
    ftBtn?.classList.add('active'); cmBtn?.classList.remove('active');
    cmWrap?.classList.add('hide');
    if (ftWrap) {
      ftWrap.style.display = '';
      ftWrap.classList.add('show');
      const cm = parseFloat((document.getElementById('height-cm') as HTMLInputElement)?.value) || 175;
      const totalIn = Math.round(cm / 2.54);
      (document.getElementById('height-ft') as HTMLInputElement).value = String(Math.floor(totalIn / 12));
      (document.getElementById('height-in') as HTMLInputElement).value = String(totalIn % 12);
    }
  }
};

window.setBMIWeight = function(unit: string) {
  bmiWUnit = unit;
  const kgBtn = document.getElementById('bmi-wkg');
  const lbBtn = document.getElementById('bmi-wlb');
  const wInput = document.getElementById('weight') as HTMLInputElement;
  const label = document.getElementById('bmi-wlabel');
  const cur = parseFloat(wInput?.value) || 75;
  if (unit === 'kg') {
    kgBtn?.classList.add('active'); lbBtn?.classList.remove('active');
    wInput.value = String(Math.round(cur / 2.205));
    if (label) label.textContent = 'kilograms';
  } else {
    lbBtn?.classList.add('active'); kgBtn?.classList.remove('active');
    wInput.value = String(Math.round(cur * 2.205));
    if (label) label.textContent = 'pounds';
  }
};

document.getElementById('calc-btn')?.addEventListener('click', () => {
  let heightM: number;
  if (bmiHUnit === 'cm') {
    heightM = (parseFloat((document.getElementById('height-cm') as HTMLInputElement).value) || 175) / 100;
  } else {
    const ft = parseFloat((document.getElementById('height-ft') as HTMLInputElement).value) || 5;
    const inch = parseFloat((document.getElementById('height-in') as HTMLInputElement).value) || 9;
    heightM = (ft * 12 + inch) * 0.0254;
  }
  const weightRaw = parseFloat((document.getElementById('weight') as HTMLInputElement).value) || 75;
  const weightKg = bmiWUnit === 'kg' ? weightRaw : weightRaw / 2.205;
  const bmi = Math.round((weightKg / (heightM * heightM)) * 10) / 10;
  const cats = [
    { max:18.5, cat:'Underweight', color:'#3B82F6', desc:'You are below the healthy weight range. Focus on nutrient-dense foods and strength training to build healthy muscle mass.' },
    { max:25, cat:'Normal Weight', color:'#22C55E', desc:'You are in the healthy weight range. Maintain your current habits with regular exercise and a balanced diet.' },
    { max:30, cat:'Overweight', color:'#F59E0B', desc:'You are slightly above the healthy range. A modest calorie deficit combined with regular exercise can help.' },
    { max:Infinity, cat:'Obese', color:'#EF4444', desc:'Your BMI indicates obesity. Consult a healthcare professional for personalised advice on safe weight management.' },
  ];
  const found = cats.find(c => bmi < c.max) || cats[cats.length-1];
  const r = document.getElementById('result');
  if (r) {
    r.style.display = 'block';
    r.innerHTML = `
      <div style="text-align:center;background:${found.color}15;border:2px solid ${found.color}40;border-radius:var(--radius-xl);padding:24px;">
        <div style="font-size:0.7rem;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:${found.color};margin-bottom:6px;">Your BMI</div>
        <div style="font-family:'Poppins',sans-serif;font-size:3.5rem;font-weight:900;color:${found.color};letter-spacing:-0.04em;line-height:1;">${bmi}</div>
        <div style="font-family:'Poppins',sans-serif;font-size:1.1rem;font-weight:700;color:${found.color};margin-top:6px;">${found.cat}</div>
        <p style="font-size:0.8rem;color:var(--text-2);margin-top:10px;line-height:1.7;">${found.desc}</p>
      </div>
      <div style="margin-top:12px;display:flex;gap:8px;justify-content:center;">
        <a href="/tools/tdee-calculator" class="btn btn-secondary btn-sm">Calculate Calories →</a>
        <a href="/workout-splits" class="btn btn-secondary btn-sm">Find My Split →</a>
      </div>
    `;
    r.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }
});
</script>
</Layout>
