---
interface Props {
  movement: string;
  name?: string;
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  tint?: string;
}
const { movement, name = '', size = 'md', class: cls = '', tint = '' } = Astro.props;
const bg = tint ? `linear-gradient(135deg,${tint}26 0%,${tint}0d 100%)` : 'linear-gradient(135deg,#F0FDF4 0%,#DCFCE7 100%)';
const sizes = { sm: 120, md: 220, lg: 320 };
const w = sizes[size];
const h = Math.round(w * 0.75);
---

<div class={`movement-svg-wrap ${cls}`} style={`width:${w}px;height:${h}px;border-radius:16px;overflow:hidden;background:${bg};display:flex;align-items:center;justify-content:center;position:relative;`} role="img" aria-label={`${name} exercise illustration`}>
  
  {/* HORIZONTAL PUSH — Bench Press family */}
  {(movement === 'bench-press' || movement === 'horizontal-push' || movement === 'Horizontal Push') && (
    <svg width={w*0.9} height={h*0.9} viewBox="0 0 300 220" fill="none">
      <!-- Bench -->
      <rect x="30" y="140" width="240" height="18" rx="6" fill="#16A34A" opacity="0.6"/>
      <rect x="50" y="158" width="20" height="40" rx="4" fill="#15803D" opacity="0.5"/>
      <rect x="230" y="158" width="20" height="40" rx="4" fill="#15803D" opacity="0.5"/>
      <!-- Person lying -->
      <ellipse cx="150" cy="128" rx="70" ry="14" fill="#854D0E" opacity="0.85"/>
      <!-- Head -->
      <circle cx="60" cy="126" r="22" fill="#FBBF24"/>
      <circle cx="55" cy="120" r="6" fill="#1C1917"/>
      <!-- Arms up -->
      <rect x="100" y="70" width="14" height="60" rx="6" fill="#FBBF24" transform="rotate(-5 100 70)"/>
      <rect x="185" y="70" width="14" height="60" rx="6" fill="#FBBF24" transform="rotate(5 185 70)"/>
      <!-- Barbell -->
      <rect x="40" y="62" width="220" height="12" rx="6" fill="#374151"/>
      <!-- Plates -->
      <rect x="32" y="48" width="22" height="40" rx="6" fill="#1F2937"/>
      <rect x="246" y="48" width="22" height="40" rx="6" fill="#1F2937"/>
      <!-- Weight coloring on chest -->
      <ellipse cx="150" cy="118" rx="30" ry="10" fill="#EF4444" opacity="0.3"/>
      <!-- Label -->
      <text x="150" y="208" text-anchor="middle" font-family="Poppins, sans-serif" font-size="11" fill="#15803D" font-weight="700">CHEST · HORIZONTAL PRESS</text>
    </svg>
  )}

  {/* INCLINE PUSH */}
  {(movement === 'incline-press' || movement === 'Incline Push') && (
    <svg width={w*0.9} height={h*0.9} viewBox="0 0 300 220" fill="none">
      <!-- Incline bench -->
      <path d="M40 180 L200 120 L220 130 L60 190 Z" fill="#16A34A" opacity="0.6"/>
      <rect x="50" y="185" width="20" height="30" rx="4" fill="#15803D" opacity="0.5"/>
      <!-- Person -->
      <ellipse cx="140" cy="115" rx="60" ry="12" fill="#854D0E" opacity="0.85" transform="rotate(-20 140 115)"/>
      <circle cx="80" cy="138" r="20" fill="#FBBF24"/>
      <!-- Arms up -->
      <line x1="125" y1="100" x2="115" y2="55" stroke="#FBBF24" stroke-width="14" stroke-linecap="round"/>
      <line x1="180" y1="88" x2="190" y2="43" stroke="#FBBF24" stroke-width="14" stroke-linecap="round"/>
      <!-- Bar -->
      <rect x="60" y="40" width="180" height="10" rx="5" fill="#374151"/>
      <rect x="52" y="28" width="18" height="34" rx="5" fill="#1F2937"/>
      <rect x="230" y="28" width="18" height="34" rx="5" fill="#1F2937"/>
      <ellipse cx="150" cy="88" rx="25" ry="8" fill="#EF4444" opacity="0.25"/>
      <text x="150" y="208" text-anchor="middle" font-family="Poppins, sans-serif" font-size="11" fill="#15803D" font-weight="700">UPPER CHEST · INCLINE PRESS</text>
    </svg>
  )}

  {/* VERTICAL PUSH — Overhead Press */}
  {(movement === 'overhead-press' || movement === 'Vertical Push') && (
    <svg width={w*0.9} height={h*0.9} viewBox="0 0 300 220" fill="none">
      <!-- Standing figure -->
      <circle cx="150" cy="40" r="22" fill="#FBBF24"/>
      <!-- Torso -->
      <path d="M125 62 Q115 100 118 140 L182 140 Q185 100 175 62 Z" fill="#854D0E" opacity="0.85"/>
      <!-- Arms raised -->
      <path d="M118 70 Q90 60 75 30" stroke="#FBBF24" stroke-width="16" stroke-linecap="round" fill="none"/>
      <path d="M182 70 Q210 60 225 30" stroke="#FBBF24" stroke-width="16" stroke-linecap="round" fill="none"/>
      <!-- Barbell overhead -->
      <rect x="50" y="20" width="200" height="10" rx="5" fill="#374151"/>
      <rect x="42" y="8" width="16" height="34" rx="5" fill="#1F2937"/>
      <rect x="242" y="8" width="16" height="34" rx="5" fill="#1F2937"/>
      <!-- Legs -->
      <path d="M130 140 L120 190" stroke="#5C3A1E" stroke-width="16" stroke-linecap="round"/>
      <path d="M170 140 L180 190" stroke="#5C3A1E" stroke-width="16" stroke-linecap="round"/>
      <!-- Shoulder highlight -->
      <circle cx="115" cy="68" r="14" fill="#F59E0B" opacity="0.35"/>
      <circle cx="185" cy="68" r="14" fill="#F59E0B" opacity="0.35"/>
      <!-- Feet -->
      <ellipse cx="117" cy="193" rx="16" ry="7" fill="#22C55E" opacity="0.7"/>
      <ellipse cx="183" cy="193" rx="16" ry="7" fill="#22C55E" opacity="0.7"/>
      <text x="150" y="210" text-anchor="middle" font-family="Poppins, sans-serif" font-size="11" fill="#15803D" font-weight="700">SHOULDERS · OVERHEAD PRESS</text>
    </svg>
  )}

  {/* PUSH-UP */}
  {movement === 'push-up' && (
    <svg width={w*0.9} height={h*0.9} viewBox="0 0 300 220" fill="none">
      <!-- Ground line -->
      <line x1="20" y1="170" x2="280" y2="170" stroke="#BBF7D0" stroke-width="2"/>
      <!-- Body plank position -->
      <line x1="60" y1="120" x2="240" y2="150" stroke="#854D0E" stroke-width="22" stroke-linecap="round" opacity="0.85"/>
      <!-- Head -->
      <circle cx="55" cy="112" r="20" fill="#FBBF24"/>
      <!-- Arms -->
      <line x1="100" y1="125" x2="100" y2="168" stroke="#FBBF24" stroke-width="14" stroke-linecap="round"/>
      <line x1="175" y1="134" x2="175" y2="168" stroke="#FBBF24" stroke-width="14" stroke-linecap="round"/>
      <!-- Feet -->
      <ellipse cx="232" cy="160" rx="14" ry="7" fill="#22C55E" opacity="0.8"/>
      <!-- Chest highlight -->
      <ellipse cx="125" cy="130" rx="22" ry="10" fill="#EF4444" opacity="0.25"/>
      <text x="150" y="200" text-anchor="middle" font-family="Poppins, sans-serif" font-size="11" fill="#15803D" font-weight="700">CHEST · PUSH-UP</text>
    </svg>
  )}

  {/* PULL-UP / VERTICAL PULL */}
  {(movement === 'pull-up' || movement === 'Vertical Pull') && (
    <svg width={w*0.9} height={h*0.9} viewBox="0 0 300 220" fill="none">
      <!-- Pull-up bar -->
      <rect x="60" y="25" width="180" height="12" rx="6" fill="#374151"/>
      <rect x="60" y="10" width="12" height="28" rx="4" fill="#4B5563"/>
      <rect x="228" y="10" width="12" height="28" rx="4" fill="#4B5563"/>
      <!-- Hands -->
      <circle cx="100" cy="37" r="10" fill="#FBBF24"/>
      <circle cx="200" cy="37" r="10" fill="#FBBF24"/>
      <!-- Arms -->
      <path d="M100 37 L115 65" stroke="#FBBF24" stroke-width="14" stroke-linecap="round"/>
      <path d="M200 37 L185 65" stroke="#FBBF24" stroke-width="14" stroke-linecap="round"/>
      <!-- Torso -->
      <path d="M115 65 L118 130 L182 130 L185 65 Z" fill="#854D0E" opacity="0.85"/>
      <!-- Head -->
      <circle cx="150" cy="52" r="20" fill="#FBBF24"/>
      <!-- Legs hanging -->
      <path d="M130 130 L125 180" stroke="#5C3A1E" stroke-width="14" stroke-linecap="round"/>
      <path d="M170 130 L175 180" stroke="#5C3A1E" stroke-width="14" stroke-linecap="round"/>
      <!-- Lat highlight -->
      <path d="M118 70 Q105 100 110 130 L120 130 L118 70Z" fill="#3B82F6" opacity="0.3"/>
      <path d="M182 70 Q195 100 190 130 L180 130 L182 70Z" fill="#3B82F6" opacity="0.3"/>
      <text x="150" y="208" text-anchor="middle" font-family="Poppins, sans-serif" font-size="11" fill="#15803D" font-weight="700">LATS · VERTICAL PULL</text>
    </svg>
  )}

  {/* ROW / HORIZONTAL PULL */}
  {(movement === 'row' || movement === 'Horizontal Pull') && (
    <svg width={w*0.9} height={h*0.9} viewBox="0 0 300 220" fill="none">
      <!-- Cable/pulley -->
      <rect x="240" y="80" width="30" height="60" rx="4" fill="#374151"/>
      <circle cx="255" cy="110" r="10" fill="#6B7280"/>
      <!-- Cable line -->
      <line x1="255" y1="110" x2="120" y2="115" stroke="#9CA3AF" stroke-width="3"/>
      <!-- Standing figure rowing -->
      <circle cx="90" cy="60" r="22" fill="#FBBF24"/>
      <path d="M80 82 Q65 110 68 145 Q68 145 112 145 Q115 110 120 82 Z" fill="#854D0E" opacity="0.85" transform="rotate(15 90 110)"/>
      <!-- Arm pulling -->
      <path d="M95 105 Q105 110 120 115" stroke="#FBBF24" stroke-width="14" stroke-linecap="round"/>
      <!-- Other arm back -->
      <path d="M85 105 Q70 108 65 115" stroke="#FBBF24" stroke-width="14" stroke-linecap="round"/>
      <!-- Legs -->
      <path d="M80 145 L75 195" stroke="#5C3A1E" stroke-width="14" stroke-linecap="round"/>
      <path d="M105 145 L108 195" stroke="#5C3A1E" stroke-width="14" stroke-linecap="round"/>
      <!-- Back highlight -->
      <ellipse cx="92" cy="115" rx="20" ry="28" fill="#3B82F6" opacity="0.25"/>
      <text x="150" y="208" text-anchor="middle" font-family="Poppins, sans-serif" font-size="11" fill="#15803D" font-weight="700">BACK · HORIZONTAL PULL</text>
    </svg>
  )}

  {/* DEADLIFT / HIP HINGE */}
  {(movement === 'deadlift' || movement === 'Hip Hinge') && (
    <svg width={w*0.9} height={h*0.9} viewBox="0 0 300 220" fill="none">
      <!-- Bar on floor -->
      <rect x="50" y="158" width="200" height="10" rx="5" fill="#374151"/>
      <circle cx="62" cy="158" r="22" fill="#1F2937" opacity="0.75"/>
      <circle cx="238" cy="158" r="22" fill="#1F2937" opacity="0.75"/>
      <circle cx="62" cy="158" r="15" fill="#374151"/>
      <circle cx="238" cy="158" r="15" fill="#374151"/>
      <!-- Hinging figure -->
      <circle cx="155" cy="60" r="22" fill="#FBBF24"/>
      <!-- Torso angled forward -->
      <path d="M145 80 Q120 110 110 155 L155 158 L185 140 L175 80 Z" fill="#854D0E" opacity="0.85"/>
      <!-- Arms reaching down -->
      <path d="M130 110 L100 157" stroke="#FBBF24" stroke-width="14" stroke-linecap="round"/>
      <path d="M168 105 L180 157" stroke="#FBBF24" stroke-width="14" stroke-linecap="round"/>
      <!-- Legs -->
      <path d="M128 158 Q118 175 115 195" stroke="#5C3A1E" stroke-width="14" stroke-linecap="round"/>
      <path d="M165 158 Q172 175 175 195" stroke="#5C3A1E" stroke-width="14" stroke-linecap="round"/>
      <!-- Hamstring/glute highlight -->
      <path d="M115 155 Q118 175 120 195 L130 195 Q125 175 128 158 Z" fill="#06B6D4" opacity="0.35"/>
      <path d="M165 158 Q172 175 170 195 L180 195 Q180 175 175 158 Z" fill="#06B6D4" opacity="0.35"/>
      <text x="150" y="208" text-anchor="middle" font-family="Poppins, sans-serif" font-size="11" fill="#15803D" font-weight="700">HAMSTRINGS · HIP HINGE</text>
    </svg>
  )}

  {/* SQUAT */}
  {movement === 'squat' && (
    <svg width={w*0.9} height={h*0.9} viewBox="0 0 300 220" fill="none">
      <!-- Bar on back -->
      <rect x="50" y="68" width="200" height="10" rx="5" fill="#374151"/>
      <rect x="42" y="55" width="16" height="36" rx="5" fill="#1F2937"/>
      <rect x="242" y="55" width="16" height="36" rx="5" fill="#1F2937"/>
      <!-- Squatting figure -->
      <circle cx="150" cy="45" r="22" fill="#FBBF24"/>
      <!-- Torso slightly forward -->
      <path d="M133 67 Q118 90 120 120 L180 120 Q182 90 167 67 Z" fill="#854D0E" opacity="0.85"/>
      <!-- Thighs at bottom (horizontal) -->
      <path d="M120 120 Q95 130 80 125" stroke="#5C3A1E" stroke-width="16" stroke-linecap="round"/>
      <path d="M180 120 Q205 130 220 125" stroke="#5C3A1E" stroke-width="16" stroke-linecap="round"/>
      <!-- Calves vertical -->
      <path d="M80 125 Q72 155 75 185" stroke="#5C3A1E" stroke-width="14" stroke-linecap="round"/>
      <path d="M220 125 Q228 155 225 185" stroke="#5C3A1E" stroke-width="14" stroke-linecap="round"/>
      <!-- Feet -->
      <ellipse cx="75" cy="187" rx="16" ry="7" fill="#22C55E" opacity="0.8"/>
      <ellipse cx="225" cy="187" rx="16" ry="7" fill="#22C55E" opacity="0.8"/>
      <!-- Quad highlight -->
      <path d="M120 120 Q100 130 85 125 Q80 155 83 185 L95 185 Q92 155 100 130 L118 120Z" fill="#10B981" opacity="0.3"/>
      <path d="M180 120 Q200 130 215 125 Q220 155 217 185 L205 185 Q208 155 200 130 L182 120Z" fill="#10B981" opacity="0.3"/>
      <text x="150" y="210" text-anchor="middle" font-family="Poppins, sans-serif" font-size="11" fill="#15803D" font-weight="700">QUADS · SQUAT</text>
    </svg>
  )}

  {/* HIP THRUST */}
  {(movement === 'hip-thrust' || movement === 'Hip Extension') && (
    <svg width={w*0.9} height={h*0.9} viewBox="0 0 300 220" fill="none">
      <!-- Bench behind -->
      <rect x="200" y="100" width="80" height="22" rx="8" fill="#16A34A" opacity="0.6"/>
      <rect x="220" y="122" width="16" height="50" rx="4" fill="#15803D" opacity="0.5"/>
      <!-- Barbell on hips -->
      <rect x="60" y="88" width="180" height="10" rx="5" fill="#374151"/>
      <rect x="52" y="76" width="18" height="34" rx="5" fill="#1F2937"/>
      <rect x="230" y="76" width="18" height="34" rx="5" fill="#1F2937"/>
      <!-- Figure doing hip thrust -->
      <!-- Back against bench -->
      <path d="M198 100 Q170 95 145 92 Q120 90 105 85" stroke="#854D0E" stroke-width="22" stroke-linecap="round"/>
      <!-- Head -->
      <circle cx="95" cy="90" r="20" fill="#FBBF24"/>
      <!-- Thighs -->
      <path d="M148 96 L135 155" stroke="#5C3A1E" stroke-width="18" stroke-linecap="round"/>
      <path d="M178 94 L188 155" stroke="#5C3A1E" stroke-width="18" stroke-linecap="round"/>
      <!-- Feet on floor -->
      <ellipse cx="130" cy="160" rx="20" ry="9" fill="#22C55E" opacity="0.8"/>
      <ellipse cx="192" cy="160" rx="20" ry="9" fill="#22C55E" opacity="0.8"/>
      <!-- Glute highlight at hips -->
      <ellipse cx="160" cy="96" rx="30" ry="12" fill="#EC4899" opacity="0.35"/>
      <text x="150" y="200" text-anchor="middle" font-family="Poppins, sans-serif" font-size="11" fill="#15803D" font-weight="700">GLUTES · HIP THRUST</text>
    </svg>
  )}

  {/* LUNGE */}
  {movement === 'lunge' && (
    <svg width={w*0.9} height={h*0.9} viewBox="0 0 300 220" fill="none">
      <!-- Figure lunging -->
      <circle cx="130" cy="40" r="22" fill="#FBBF24"/>
      <!-- Torso upright -->
      <path d="M118 62 Q112 95 114 130 L148 130 Q148 95 142 62 Z" fill="#854D0E" opacity="0.85"/>
      <!-- Front leg down -->
      <path d="M125 130 Q110 155 90 180" stroke="#5C3A1E" stroke-width="16" stroke-linecap="round"/>
      <path d="M90 180 Q82 182 75 180" stroke="#5C3A1E" stroke-width="10" stroke-linecap="round"/>
      <!-- Back leg extended -->
      <path d="M138 130 Q160 145 185 145" stroke="#5C3A1E" stroke-width="16" stroke-linecap="round"/>
      <path d="M185 145 Q186 168 185 185" stroke="#5C3A1E" stroke-width="14" stroke-linecap="round"/>
      <!-- Rear knee near floor -->
      <ellipse cx="183" cy="187" rx="14" ry="7" fill="#22C55E" opacity="0.7"/>
      <!-- Front foot -->
      <ellipse cx="80" cy="183" rx="18" ry="8" fill="#22C55E" opacity="0.8"/>
      <!-- Quad highlight -->
      <path d="M125 130 Q108 155 88 180 L96 184 Q112 158 135 132Z" fill="#10B981" opacity="0.3"/>
      <!-- Arms for balance -->
      <path d="M118 80 Q105 85 95 78" stroke="#FBBF24" stroke-width="12" stroke-linecap="round"/>
      <path d="M142 80 Q155 85 165 78" stroke="#FBBF24" stroke-width="12" stroke-linecap="round"/>
      <text x="150" y="210" text-anchor="middle" font-family="Poppins, sans-serif" font-size="11" fill="#15803D" font-weight="700">QUADS · LUNGE</text>
    </svg>
  )}

  {/* LEG EXTENSION / KNEE EXTENSION */}
  {(movement === 'leg-extension' || movement === 'Knee Extension') && (
    <svg width={w*0.9} height={h*0.9} viewBox="0 0 300 220" fill="none">
      <!-- Machine seat -->
      <rect x="30" y="100" width="120" height="50" rx="8" fill="#16A34A" opacity="0.4"/>
      <rect x="30" y="148" width="20" height="50" rx="6" fill="#15803D" opacity="0.4"/>
      <!-- Back pad -->
      <rect x="150" y="60" width="20" height="90" rx="8" fill="#16A34A" opacity="0.5"/>
      <!-- Ankle pad/weight -->
      <rect x="200" y="148" width="50" height="14" rx="5" fill="#374151"/>
      <!-- Seated person -->
      <circle cx="105" cy="65" r="20" fill="#FBBF24"/>
      <path d="M92 85 Q85 100 88 148 L145 148 Q145 100 118 85 Z" fill="#854D0E" opacity="0.85"/>
      <!-- Leg extending forward -->
      <path d="M120 148 Q150 148 205 148" stroke="#5C3A1E" stroke-width="18" stroke-linecap="round"/>
      <!-- Arm on machine -->
      <path d="M92 110 Q65 115 55 118" stroke="#FBBF24" stroke-width="12" stroke-linecap="round"/>
      <!-- Quad highlight -->
      <path d="M120 148 Q148 148 205 148 Q205 140 148 136 L118 140 Z" fill="#10B981" opacity="0.4"/>
      <text x="150" y="210" text-anchor="middle" font-family="Poppins, sans-serif" font-size="11" fill="#15803D" font-weight="700">QUADS · LEG EXTENSION</text>
    </svg>
  )}

  {/* LEG CURL / KNEE FLEXION */}
  {(movement === 'leg-curl' || movement === 'Knee Flexion') && (
    <svg width={w*0.9} height={h*0.9} viewBox="0 0 300 220" fill="none">
      <!-- Machine -->
      <rect x="30" y="90" width="240" height="30" rx="8" fill="#16A34A" opacity="0.4"/>
      <rect x="50" y="118" width="20" height="50" rx="6" fill="#15803D" opacity="0.4"/>
      <rect x="220" y="118" width="20" height="50" rx="6" fill="#15803D" opacity="0.4"/>
      <!-- Ankle pad -->
      <rect x="185" y="75" width="40" height="16" rx="5" fill="#374151"/>
      <!-- Lying person, leg curled -->
      <path d="M55" y1="105" x1="55" y2="105" />
      <line x1="55" y1="100" x2="185" y2="100" stroke="#854D0E" stroke-width="22" stroke-linecap="round" opacity="0.85"/>
      <!-- Head -->
      <circle cx="50" cy="100" r="18" fill="#FBBF24"/>
      <!-- Curled leg -->
      <path d="M185 100 Q200 95 215 80" stroke="#5C3A1E" stroke-width="18" stroke-linecap="round"/>
      <!-- Hamstring highlight -->
      <path d="M185 100 Q198 96 214 82 L220 88 Q204 103 190 108 Z" fill="#06B6D4" opacity="0.4"/>
      <text x="150" y="200" text-anchor="middle" font-family="Poppins, sans-serif" font-size="11" fill="#15803D" font-weight="700">HAMSTRINGS · LEG CURL</text>
    </svg>
  )}

  {/* LATERAL RAISE / SHOULDER ABDUCTION */}
  {(movement === 'lateral-raise' || movement === 'Shoulder Abduction') && (
    <svg width={w*0.9} height={h*0.9} viewBox="0 0 300 220" fill="none">
      <!-- Figure standing -->
      <circle cx="150" cy="42" r="22" fill="#FBBF24"/>
      <path d="M136 64 Q128 100 130 150 L170 150 Q172 100 164 64 Z" fill="#854D0E" opacity="0.85"/>
      <!-- Arms raised out to sides -->
      <path d="M132 80 Q100 75 70 80" stroke="#FBBF24" stroke-width="14" stroke-linecap="round"/>
      <path d="M168 80 Q200 75 230 80" stroke="#FBBF24" stroke-width="14" stroke-linecap="round"/>
      <!-- Dumbbells -->
      <rect x="52" y="74" width="22" height="12" rx="4" fill="#374151"/>
      <rect x="226" y="74" width="22" height="12" rx="4" fill="#374151"/>
      <!-- Legs -->
      <path d="M138 150 L132 195" stroke="#5C3A1E" stroke-width="14" stroke-linecap="round"/>
      <path d="M162 150 L168 195" stroke="#5C3A1E" stroke-width="14" stroke-linecap="round"/>
      <!-- Side delt highlights -->
      <circle cx="128" cy="78" r="16" fill="#F59E0B" opacity="0.4"/>
      <circle cx="172" cy="78" r="16" fill="#F59E0B" opacity="0.4"/>
      <text x="150" y="210" text-anchor="middle" font-family="Poppins, sans-serif" font-size="11" fill="#15803D" font-weight="700">SIDE DELTS · LATERAL RAISE</text>
    </svg>
  )}

  {/* CURL / ELBOW FLEXION */}
  {(movement === 'curl' || movement === 'Elbow Flexion') && (
    <svg width={w*0.9} height={h*0.9} viewBox="0 0 300 220" fill="none">
      <!-- Standing figure -->
      <circle cx="150" cy="42" r="22" fill="#FBBF24"/>
      <path d="M136 64 Q128 100 130 150 L170 150 Q172 100 164 64 Z" fill="#854D0E" opacity="0.85"/>
      <!-- Right arm curling up -->
      <path d="M130 90 Q108 95 98 88" stroke="#FBBF24" stroke-width="14" stroke-linecap="round"/>
      <!-- Left arm at side with dumbbell -->
      <path d="M170 90 Q172 120 172 148" stroke="#FBBF24" stroke-width="14" stroke-linecap="round"/>
      <rect x="162" y="145" width="24" height="10" rx="4" fill="#374151"/>
      <!-- Dumbbell being curled -->
      <rect x="80" y="80" width="24" height="10" rx="4" fill="#374151"/>
      <!-- Legs -->
      <path d="M138 150 L133 192" stroke="#5C3A1E" stroke-width="14" stroke-linecap="round"/>
      <path d="M162 150 L167 192" stroke="#5C3A1E" stroke-width="14" stroke-linecap="round"/>
      <!-- Feet -->
      <ellipse cx="130" cy="194" rx="15" ry="6" fill="#22C55E" opacity="0.8"/>
      <ellipse cx="170" cy="194" rx="15" ry="6" fill="#22C55E" opacity="0.8"/>
      <!-- Bicep highlight -->
      <ellipse cx="115" cy="88" rx="18" ry="10" fill="#8B5CF6" opacity="0.4"/>
