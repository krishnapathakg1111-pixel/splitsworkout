---
// Small line icons for equipment (24×24, currentColor). Decorative: the equipment name always appears as text next to it.
interface Props { name: string; size?: number }
const { name, size = 18 } = Astro.props;
const key = name.toLowerCase();
const kind =
  key.includes('smith') ? 'smith' : key.includes('ez') ? 'ez' : key.includes('trap') ? 'trap' : key.includes('landmine') ? 'landmine' :
  key.includes('barbell') ? 'barbell' : key.includes('dumbbell') ? 'dumbbell' : key.includes('kettlebell') ? 'kettlebell' :
  key.includes('cable') ? 'cable' : key.includes('machine') ? 'machine' : key.includes('band') ? 'band' :
  key.includes('ball') ? 'ball' : key.includes('plate') ? 'plate' : key.includes('bodyweight') || key.includes('pull-up') || key.includes('dip') ? 'body' : 'dumbbell';
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {kind === 'barbell' && (<><line x1="2" y1="12" x2="22" y2="12"/><rect x="4" y="7" width="2.5" height="10" rx="1"/><rect x="17.5" y="7" width="2.5" height="10" rx="1"/></>)}
  {kind === 'dumbbell' && (<><line x1="8" y1="12" x2="16" y2="12"/><rect x="4" y="8" width="4" height="8" rx="1"/><rect x="16" y="8" width="4" height="8" rx="1"/></>)}
  {kind === 'ez' && (<><polyline points="2,12 8,12 10,9 14,15 16,12 22,12"/><rect x="3" y="8" width="2" height="8" rx="1"/><rect x="19" y="8" width="2" height="8" rx="1"/></>)}
  {kind === 'trap' && (<><polygon points="7,4 17,4 21,12 17,20 7,20 3,12"/></>)}
  {kind === 'landmine' && (<><line x1="4" y1="20" x2="20" y2="6"/><circle cx="4" cy="20" r="1.5"/><rect x="17" y="4" width="3" height="5" rx="1" transform="rotate(40 18 6)"/></>)}
  {kind === 'smith' && (<><line x1="5" y1="3" x2="5" y2="21"/><line x1="19" y1="3" x2="19" y2="21"/><line x1="3" y1="12" x2="21" y2="12"/></>)}
  {kind === 'kettlebell' && (<><circle cx="12" cy="14" r="6"/><path d="M9 8.5 Q12 3 15 8.5"/></>)}
  {kind === 'cable' && (<><circle cx="7" cy="6" r="3"/><path d="M7 9 L7 16 L17 18"/><rect x="16" y="16" width="5" height="4" rx="1"/></>)}
  {kind === 'machine' && (<><rect x="3" y="4" width="6" height="16" rx="1"/><line x1="3" y1="9" x2="9" y2="9"/><line x1="3" y1="14" x2="9" y2="14"/><path d="M9 7 L19 7 L19 14"/></>)}
  {kind === 'band' && (<><path d="M5 18 C3 8 9 4 12 9 C15 14 21 10 19 5"/><line x1="4" y1="18" x2="7" y2="18"/><line x1="17" y1="5" x2="20" y2="5"/></>)}
  {kind === 'ball' && (<><circle cx="12" cy="12" r="8"/><path d="M5 9 Q12 13 19 9"/></>)}
  {kind === 'plate' && (<><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="2.5"/></>)}
  {kind === 'body' && (<><circle cx="12" cy="5" r="2.2"/><path d="M12 8 L12 15 M12 9 L7 12 M12 9 L17 12 M12 15 L8 21 M12 15 L16 21"/></>)}
</svg>
