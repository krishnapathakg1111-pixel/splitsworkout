---
interface Props {
  type: 'dumbbell' | 'barbell' | 'star' | 'sparkle' | 'squiggle' | 'crown' | 'shaker' | 'leaf' | 'heart' | 'arrow' | 'ring';
  size?: number;
  color?: string;
  class?: string;
  rotate?: number;
}
const { type, size = 32, color = '#22C55E', class: cls = '', rotate = 0 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class={`decorative-element ${cls}`}
  style={rotate ? `transform:rotate(${rotate}deg)` : ''}
  aria-hidden="true"
>
  {type === 'dumbbell' && (
    <>
      <rect x="10" y="13" width="12" height="6" rx="2" fill={color}/>
      <rect x="4" y="9" width="8" height="14" rx="3" fill={color} opacity="0.9"/>
      <rect x="20" y="9" width="8" height="14" rx="3" fill={color} opacity="0.9"/>
      <rect x="5" y="11" width="3" height="10" rx="1.5" fill={color} opacity="0.6"/>
      <rect x="24" y="11" width="3" height="10" rx="1.5" fill={color} opacity="0.6"/>
    </>
  )}
  {type === 'barbell' && (
    <>
      <rect x="8" y="14" width="16" height="4" rx="2" fill={color}/>
      <rect x="2" y="10" width="8" height="12" rx="3" fill={color} opacity="0.9"/>
      <rect x="22" y="10" width="8" height="12" rx="3" fill={color} opacity="0.9"/>
    </>
  )}
  {type === 'star' && (
    <path d="M16 2l3.09 9.18H29l-8.09 5.73 3.09 9.18L16 21.36l-7.91 4.73 3.09-9.18L3 11.18h9.91z" fill={color}/>
  )}
  {type === 'sparkle' && (
    <>
      <path d="M16 2 L17.5 14.5 L30 16 L17.5 17.5 L16 30 L14.5 17.5 L2 16 L14.5 14.5 Z" fill={color}/>
      <circle cx="6" cy="6" r="2" fill={color} opacity="0.5"/>
      <circle cx="26" cy="8" r="1.5" fill={color} opacity="0.4"/>
    </>
  )}
  {type === 'squiggle' && (
    <path d="M4 22 Q8 14 12 18 Q16 22 20 14 Q24 6 28 10" stroke={color} stroke-width="2.5" fill="none" stroke-linecap="round"/>
  )}
  {type === 'crown' && (
    <>
      <path d="M4 24 L7 10 L13 16 L16 8 L19 16 L25 10 L28 24Z" fill={color} opacity="0.9"/>
      <rect x="4" y="24" width="24" height="4" rx="2" fill={color}/>
      <circle cx="7" cy="10" r="2" fill="#FDE68A"/>
      <circle cx="16" cy="8" r="2" fill="#FDE68A"/>
      <circle cx="25" cy="10" r="2" fill="#FDE68A"/>
    </>
  )}
  {type === 'shaker' && (
    <>
      <!-- Shaker bottle -->
      <path d="M12 4 L10 8 L10 26 Q10 28 16 28 Q22 28 22 26 L22 8 L20 4Z" fill={color} opacity="0.8"/>
      <rect x="10" y="4" width="12" height="4" rx="2" fill={color}/>
      <rect x="13" y="2" width="6" height="4" rx="2" fill={color} opacity="0.7"/>
      <!-- Label -->
      <rect x="11" y="14" width="10" height="8" rx="2" fill="white" opacity="0.4"/>
    </>
  )}
  {type === 'leaf' && (
    <path d="M16 28 Q4 20 4 10 Q10 4 20 8 Q28 12 28 20 Q22 28 16 28Z" fill={color} opacity="0.7"/>
  )}
  {type === 'heart' && (
    <path d="M16 26 Q6 18 6 12 A5 5 0 0 1 16 8 A5 5 0 0 1 26 12 Q26 18 16 26Z" fill={color}/>
  )}
  {type === 'arrow' && (
    <>
      <path d="M6 16 L22 16" stroke={color} stroke-width="2.5" stroke-linecap="round"/>
      <path d="M18 10 L24 16 L18 22" stroke={color} stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
    </>
  )}
  {type === 'ring' && (
    <circle cx="16" cy="16" r="11" stroke={color} stroke-width="3" fill="none" stroke-dasharray="4 3"/>
  )}
</svg>
